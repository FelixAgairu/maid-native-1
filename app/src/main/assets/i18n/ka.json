  "Edit system prompt": "\u10e1\u10d8\u10e1\u10e2\u10d4\u10db\u10d8\u10e1 \u10e0\u10d4\u10d3\u10d0\u10e5\u10e2\u10d8\u10e0\u10d4\u10d1\u10d0",
  "Endpoint": "\u10e1\u10d0\u10d1\u10dd\u10da\u10dd\u10dd \u10ec\u10d4\u10e0\u10e2\u10d8\u10da\u10d8",
  "Endpoint found": "\u10d0\u10e6\u10db\u10dd\u10e9\u10d4\u10dc\u10d8\u10da\u10d8 \u10e1\u10d0\u10d1\u10dd\u10da\u10dd\u10dd \u10ec\u10d4\u10e0\u10e2\u10d8\u10da\u10d8",
  "Enter a port between 1 and 65535": "\u10e8\u10d4\u10d8\u10e7\u10d5\u10d0\u10dc\u10d4\u10d7 \u10de\u10dd\u10e0\u10e2\u10d8 1 \u10d3\u10d0 65535 \u10e8\u10dd\u10e0\u10d8\u10e1",
  "Enter an http or https URL": "\u10e8\u10d4\u10d8\u10e7\u10d5\u10d0\u10dc\u10d4\u10d7 http \u10d0\u10dc https URL",
  "Expand all": "\u10d2\u10d0\u10d0\u10e4\u10d0\u10e0\u10d7\u10dd\u10d5\u10d4\u10d7 \u10e7\u10d5\u10d4\u10da\u10d0",
  "Export": "\u10d4\u10e5\u10e1\u10de\u10dd\u10e0\u10e2\u10d8",
