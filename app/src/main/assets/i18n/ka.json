  "Average response": "\u10e1\u10d0\u10e8\u10e3\u10d0\u10da\u10dd \u10e0\u10d4\u10d0\u10d2\u10d8\u10e0\u10d4\u10d1\u10d0",
  "Average speed": "\u10e1\u10d0\u10e8\u10e3\u10d0\u10da\u10dd \u10e1\u10d8\u10e9\u10e5\u10d0\u10e0\u10d4",
