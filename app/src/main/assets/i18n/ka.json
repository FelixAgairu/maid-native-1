  "Must be a JSON object": "\u10d4\u10e1 \u10e3\u10dc\u10d3\u10d0 \u10d8\u10e7\u10dd\u10e1 JSON \u10dd\u10d1\u10d8\u10d4\u10e5\u10e2\u10d8",
  "Name": "\u10e1\u10d0\u10ee\u10d4\u10da\u10d8",
  "Network": "\u10e5\u10e1\u10d4\u10da\u10d8",
  "New chat": "\u10d0\u10ee\u10d0\u10da\u10d8 \u10e9\u10d0\u10d9\u10d8\u10d7\u10ee\u10d5\u10d0",
