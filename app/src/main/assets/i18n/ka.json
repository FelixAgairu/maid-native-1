  "Scan options": "\u10e1\u10d9\u10d0\u10dc\u10d8\u10e0\u10d4\u10d1\u10d8\u10e1 \u10d5\u10d0\u10e0\u10d8\u10d0\u10dc\u10e2\u10d4\u10d1\u10d8",
  "Scroll long messages": "\u10d2\u10e0\u10eb\u10d4\u10da\u10d8 \u10e8\u10d4\u10e2\u10e7\u10dd\u10d1\u10d8\u10dc\u10d4\u10d1\u10d4\u10d1\u10d8",
