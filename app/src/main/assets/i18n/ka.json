  "Known total": "\u10ea\u10dc\u10dd\u10d1\u10d8\u10da\u10d8 \u10ef\u10d0\u10db\u10e3\u10e0\u10d8",
  "Known total (partial)": "\u10ea\u10dc\u10dd\u10d1\u10d8\u10da\u10d8 \u10ef\u10d0\u10db\u10e3\u10e0\u10d8 (\u10dc\u10d0\u10ec\u10d8\u10da\u10dd\u10d1\u10e0\u10d8\u10d5\u10d8)",
