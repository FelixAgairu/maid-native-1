  "Conversations": "\u0c1a\u0c30\u0c4d\u0c1a\u0c32\u0c41",
  "Copy": "\u0c15\u0c3e\u0c2a\u0c40",
  "Cumulative input + output across all retained branches of this conversation, including tool requests. Deleted replies are excluded.": "\u0c1f\u0c42\u0c32\u0c4d \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c32\u0c24\u0c4b \u0c38\u0c39\u0c3e \u0c08 \u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c3f\u0c32\u0c41\u0c2a\u0c41\u0c15\u0c41\u0c28\u0c4d\u0c28 \u0c36\u0c3e\u0c16\u0c32\u0c32\u0c4b \u0c38\u0c02\u0c1a\u0c3f\u0c24 \u0c07\u0c28\u0c4d\u0c2a\u0c41\u0c1f\u0c4d + \u0c05\u0c35\u0c41\u0c1f\u0c4d\u0c2a\u0c41\u0c1f\u0c4d. \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c38\u0c2e\u0c3e\u0c27\u0c3e\u0c28\u0c3e\u0c32\u0c41 \u0c2e\u0c3f\u0c28\u0c39\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c4d\u0c21\u0c3e\u0c2f\u0c3f.",
  "Cumulative probability cutoff.": "\u0c38\u0c02\u0c1a\u0c3f\u0c24 \u0c38\u0c02\u0c2d\u0c3e\u0c35\u0c4d\u0c2f\u0c24 \u0c15\u0c1f\u0c4d\u0c06\u0c2b\u0c4d.",
  "Current date and time.": "\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24 \u0c24\u0c47\u0c26\u0c40 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c2e\u0c2f\u0c02.",
  "Cutoff relative to the top token.": "\u0c0e\u0c17\u0c41\u0c35 \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d\u0c15\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f \u0c15\u0c1f\u0c4d\u0c06\u0c2b\u0c4d.",
  "Date & time": "\u0c24\u0c47\u0c26\u0c40 & \u0c38\u0c2e\u0c2f\u0c02",
  "Delete": "\u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c41",
  "Delete conversation": "\u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23\u0c28\u0c41 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c41",
  "Delete message": "\u0c38\u0c02\u0c26\u0c47\u0c36\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c41",
  "Delete preset": "\u0c2e\u0c41\u0c02\u0c26\u0c38\u0c4d\u0c24\u0c41 \u0c38\u0c46\u0c1f\u0c4d\u0c28\u0c41 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c41",
  "Delete server": "\u0c38\u0c30\u0c4d\u0c35\u0c30\u0c4d\u0c28\u0c41 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c41",
  "Delete this conversation permanently? This can't be undone.": "\u0c08 \u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23\u0c28\u0c41 \u0c36\u0c3e\u0c36\u0c4d\u0c35\u0c24\u0c02\u0c17\u0c3e \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c02?",
  "Delete this message and everything below it? This can't be undone.": "\u0c08 \u0c38\u0c02\u0c26\u0c47\u0c36\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c26\u0c3e\u0c28\u0c3f \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26 \u0c09\u0c28\u0c4d\u0c28 \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c26\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c02?",
  "Deny": "\u0c24\u0c3f\u0c30\u0c38\u0c4d\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c02",
  "Dialog": "\u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23",
  "Dice roller": "\u0c21\u0c2f\u0c3e\u0c38\u0c4d \u0c30\u0c4b\u0c32\u0c30\u0c4d",
  "Discourages frequent repeats.": "\u0c24\u0c30\u0c1a\u0c41\u0c17\u0c3e \u0c2a\u0c41\u0c28\u0c30\u0c3e\u0c35\u0c43\u0c24\u0c02 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c3f\u0c37\u0c47\u0c27\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",
  "Don't ask again": "\u0c2e\u0c33\u0c4d\u0c33\u0c40 \u0c05\u0c21\u0c17\u0c35\u0c26\u0c4d\u0c26\u0c41",
  "Edit MCP server": "MCP \u0c38\u0c30\u0c4d\u0c35\u0c30\u0c4d\u0c28\u0c41 \u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c41",
  "Edit file": "\u0c2b\u0c48\u0c32\u0c4d\u0c28\u0c41 \u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c41",
  "Edit message": "\u0c38\u0c02\u0c26\u0c47\u0c36\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c41",
  "Edit system prompt": "\u0c35\u0c4d\u0c2f\u0c35\u0c38\u0c4d\u0c25 \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c2a\u0c4d\u0c1f\u0c4d \u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c41",
  "Endpoint": "\u0c2e\u0c41\u0c17\u0c3f\u0c02\u0c2a\u0c41 \u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d",
  "Endpoint found": "\u0c32\u0c2d\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2e\u0c41\u0c17\u0c3f\u0c02\u0c2a\u0c41 \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02",
  "Enter a port between 1 and 65535": "1 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 65535 \u0c2e\u0c27\u0c4d\u0c2f \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c41\u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",
  "Enter an http or https URL": "\u0c12\u0c15 http \u0c32\u0c47\u0c26\u0c3e https URL \u0c28\u0c41 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",
  "Expand all": "\u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c35\u0c3f\u0c38\u0c4d\u0c24\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "Export": "\u0c0e\u0c17\u0c41\u0c2e\u0c24\u0c41\u0c32\u0c41",
  "Export all": "\u0c05\u0c28\u0c4d\u0c28\u0c40 \u0c0e\u0c17\u0c41\u0c2e\u0c24\u0c3f",
  "Export media": "\u0c0e\u0c17\u0c41\u0c2e\u0c24\u0c3f \u0c2e\u0c40\u0c21\u0c3f\u0c2f\u0c3e",
  "Fades out while you type. Images are cropped to the pill and copied into the app.": "\u0c2e\u0c40\u0c30\u0c41 \u0c1f\u0c48\u0c2a\u0c4d \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c41 \u0c15\u0c24\u0c4d\u0c24\u0c3f\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c28\u0c41\u0c35\u0c30\u0c4d\u0c24\u0c28\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c15\u0c3e\u0c2a\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c24\u0c3e\u0c2f\u0c3f.",
  "Fetch URL": "URL \u0c28\u0c41 \u0c24\u0c40\u0c38\u0c41\u0c15\u0c46\u0c33\u0c4d\u0c32\u0c02\u0c21\u0c3f",
  "Files": "\u0c2b\u0c48\u0c33\u0c4d\u0c32\u0c41",
  "Find text in a file linked to the chat.": "\u0c1a\u0c3e\u0c1f\u0c4d\u0c15\u0c41 \u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c2b\u0c48\u0c32\u0c4d\u0c32\u0c4b \u0c1f\u0c46\u0c15\u0c4d\u0c38\u0c4d\u0c1f\u0c4d\u0c28\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c02\u0c21\u0c3f.",
  "Frequency penalty": "\u0c2b\u0c4d\u0c30\u0c40\u0c15\u0c4d\u0c35\u0c46\u0c28\u0c4d\u0c38\u0c40 \u0c36\u0c3f\u0c15\u0c4d\u0c37",
  "Hide reasoning": "\u0c26\u0c3e\u0c1a\u0c21\u0c02",
  "Hide tool calls": "\u0c1f\u0c42\u0c32\u0c4d \u0c15\u0c3e\u0c32\u0c4d\u0c38\u0c4d \u0c26\u0c3e\u0c1a\u0c02\u0c21\u0c3f",
  "Hide tool result": "\u0c38\u0c3e\u0c27\u0c28\u0c02 \u0c2b\u0c32\u0c3f\u0c24\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c26\u0c3e\u0c1a\u0c02\u0c21\u0c3f",
  "Higher is more random.": "\u0c0e\u0c24\u0c4d\u0c24\u0c48\u0c28\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c02\u0c24 \u0c2f\u0c3e\u0c26\u0c43\u0c1a\u0c4d\u0c1b\u0c3f\u0c15\u0c2e\u0c48\u0c28\u0c26\u0c3f.",
  "Image": "\u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c02",
  "Import": "\u0c26\u0c3f\u0c17\u0c41\u0c2e\u0c24\u0c3f",
  "In use": "\u0c35\u0c3e\u0c21\u0c41\u0c15\u0c32\u0c4b",
  "In {0} \u00b7 Out {1}": "{0} \u00b7 \u0c05\u0c35\u0c41\u0c1f\u0c4d {1}",
  "In {0} \u00b7 Out {1} \u00b7 {2} {3} tokens": "{0} \u00b7 \u0c05\u0c35\u0c41\u0c1f\u0c4d {1} \u00b7 {2} {3} \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d\u0c32\u0c32\u0c4b",
  "Includes attached images and audio in exported conversations.": "\u0c0e\u0c17\u0c41\u0c2e\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23\u0c32\u0c32\u0c4b \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c06\u0c21\u0c3f\u0c2f\u0c4b\u0c28\u0c41 \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f.",
  "Input includes history sent again on each request. This is usage, not the number of tokens currently in the model's context window.": "\u0c07\u0c28\u0c4d\u0c2a\u0c41\u0c1f\u0c4d \u0c2a\u0c4d\u0c30\u0c24\u0c3f \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c2a\u0c48 \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c2a\u0c02\u0c2a\u0c3f\u0c28 \u0c1a\u0c30\u0c3f\u0c24\u0c4d\u0c30\u0c28\u0c41 \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f. \u0c07\u0c26\u0c3f \u0c2e\u0c4b\u0c21\u0c32\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c2d \u0c35\u0c3f\u0c02\u0c21\u0c4b\u0c32\u0c4b \u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24\u0c02 \u0c09\u0c28\u0c4d\u0c28 \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d\u0c32 \u0c38\u0c02\u0c16\u0c4d\u0c2f \u0c15\u0c3e\u0c26\u0c41.",
  "Input tokens": "\u0c07\u0c28\u0c4d\u0c2a\u0c41\u0c1f\u0c4d \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d\u0c32\u0c41",
  "Input \u00b7 {0}\nOutput \u00b7 {1}": "\u0c07\u0c28\u0c4d\u0c2a\u0c41\u0c1f\u0c4d {0} \u0c05\u0c35\u0c41\u0c1f\u0c4d\u0c2a\u0c41\u0c1f\u0c4d {1}",
  "JavaScript": "\u0c1c\u0c3e\u0c35\u0c3e\u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c3f\u0c2a\u0c4d\u0c1f\u0c4d",
  "Key can't be decrypted \u2014 re-save": "\u0c15\u0c40 \u0c21\u0c40\u0c15\u0c4d\u0c30\u0c3f\u0c2a\u0c4d\u0c1f\u0c4d \u0c38\u0c3e\u0c27\u0c4d\u0c2f\u0c02 \u0c15\u0c3e\u0c26\u0c41  \u2047  \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c38\u0c47\u0c35\u0c4d",
  "Known total": "\u0c24\u0c46\u0c32\u0c3f\u0c38\u0c3f\u0c28 \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02",
  "Known total (partial)": "\u0c24\u0c46\u0c32\u0c3f\u0c38\u0c3f\u0c28 \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 (\u0c2d\u0c3e\u0c17\u0c2e\u0c41)",
  "Language": "\u0c2d\u0c3e\u0c37",
  "Link file": "\u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c2b\u0c48\u0c32\u0c4d",
  "Link files to a chat.": "\u0c2b\u0c48\u0c32\u0c4d\u0c32\u0c28\u0c41 \u0c1a\u0c3e\u0c1f\u0c4d\u0c15\u0c41 \u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",
  "Linked files": "\u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c2b\u0c48\u0c33\u0c4d\u0c32\u0c41",
  "List": "\u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e",
  "Local": "\u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3f\u0c15\u0c02\u0c17\u0c3e",
  "Long messages and reasoning scroll inside their cards. Expand any card to read it in full.": "\u0c38\u0c41\u0c26\u0c40\u0c30\u0c4d\u0c18 \u0c38\u0c02\u0c26\u0c47\u0c36\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c3e\u0c30\u0c3f \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32 \u0c32\u0c4b\u0c2a\u0c32 \u0c24\u0c30\u0c4d\u0c15\u0c02 \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c4b\u0c32\u0c4d. \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1a\u0c26\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c28\u0c41 \u0c35\u0c3f\u0c38\u0c4d\u0c24\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",
  "Media token costs are not included in the estimate.": "\u0c2e\u0c40\u0c21\u0c3f\u0c2f\u0c3e \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d\u0c32 \u0c16\u0c30\u0c4d\u0c1a\u0c41\u0c32\u0c41 \u0c08 \u0c05\u0c02\u0c1a\u0c28\u0c3e\u0c32\u0c4b \u0c1a\u0c47\u0c30\u0c4d\u0c1a\u0c2c\u0c21\u0c32\u0c47\u0c26\u0c41.",
  "Message": "\u0c38\u0c02\u0c26\u0c47\u0c36\u0c02",
  "Min P": "\u0c2e\u0c3f\u0c28\u0c4d \u0c2a\u0c3f",
  "Model": "\u0c28\u0c2e\u0c42\u0c28\u0c3e",
  "Modify": "\u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c41",
  "More chat actions": "\u0c2e\u0c30\u0c3f\u0c28\u0c4d\u0c28\u0c3f \u0c1a\u0c3e\u0c1f\u0c4d \u0c1a\u0c30\u0c4d\u0c2f\u0c32\u0c41",
  "Must be a JSON object": "\u0c07\u0c26\u0c3f JSON \u0c35\u0c38\u0c4d\u0c24\u0c41\u0c35\u0c41\u0c17\u0c3e \u0c09\u0c02\u0c21\u0c3e\u0c32\u0c3f",
  "Name": "\u0c2a\u0c47\u0c30\u0c41",
  "Network": "\u0c28\u0c46\u0c1f\u0c4d\u0c35\u0c30\u0c4d\u0c15\u0c4d",
  "New chat": "\u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c1a\u0c3e\u0c1f\u0c4d",
  "New file": "\u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c2b\u0c48\u0c32\u0c4d",
  "Next branch": "\u0c24\u0c26\u0c41\u0c2a\u0c30\u0c3f \u0c36\u0c3e\u0c16",
  "No API key": "\u0c0e\u0c2a\u0c3f\u0c10 \u0c15\u0c40 \u0c32\u0c47\u0c26\u0c41",
  "No chats yet": "\u0c07\u0c02\u0c15\u0c3e \u0c1a\u0c3e\u0c1f\u0c4d \u0c32\u0c47\u0c26\u0c41",
  "No matching models": "\u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c2f\u0c47 \u0c28\u0c2e\u0c42\u0c28\u0c3e\u0c32\u0c41 \u0c32\u0c47\u0c35\u0c41",
  "No models loaded. Tap the scan button or refresh to fetch /models.": "\u0c2e\u0c4b\u0c21\u0c32\u0c4d\u0c38\u0c4d \u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c32\u0c47\u0c26\u0c41. \u0c38\u0c4d\u0c15\u0c3e\u0c28\u0c4d \u0c2c\u0c1f\u0c28\u0c4d\u0c28\u0c41 \u0c28\u0c4a\u0c15\u0c4d\u0c15\u0c02\u0c21\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c2e\u0c42\u0c28\u0c3e\u0c32\u0c28\u0c41 \u0c24\u0c40\u0c38\u0c41\u0c15\u0c41\u0c30\u0c3e\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c30\u0c3f\u0c2b\u0c4d\u0c30\u0c46\u0c37\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",
  "None": "\u0c0f\u0c26\u0c40 \u0c32\u0c47\u0c26\u0c41",
  "Nothing saved yet. A preset keeps a Base URL and its API key together, so switching endpoints takes one tap.": "\u0c12\u0c15 \u0c2a\u0c4d\u0c30\u0c40\u0c38\u0c46\u0c1f\u0c4d \u0c2c\u0c47\u0c38\u0c4d URL \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c26\u0c3e\u0c28\u0c3f API \u0c15\u0c40\u0c28\u0c3f \u0c15\u0c32\u0c3f\u0c38\u0c3f \u0c09\u0c02\u0c1a\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f, \u0c15\u0c3e\u0c2c\u0c1f\u0c4d\u0c1f\u0c3f \u0c0e\u0c02\u0c21\u0c4d \u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u0c32\u0c28\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c21\u0c02 \u0c12\u0c15 \u0c28\u0c4a\u0c15\u0c4d\u0c15\u0c21\u0c02 \u0c2a\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",
  "Nudges toward new topics.": "\u0c28\u0c42\u0c24\u0c28 \u0c05\u0c02\u0c36\u0c3e\u0c32 \u0c35\u0c48\u0c2a\u0c41 \u0c2e\u0c4a\u0c17\u0c4d\u0c17\u0c41 \u0c1a\u0c42\u0c2a\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",
  "Off": "\u0c06\u0c2a\u0c3f\u0c35\u0c47\u0c2f\u0c02\u0c21\u0c3f",
  "Off: system certificates only. On: system and user-installed CA certificates for API and MCP connections. Hostname and certificate checks remain enabled. Restart the app after installing or removing a CA.": "\u0c06\u0c2a\u0c3f\u0c35\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f\u0c03 \u0c38\u0c3f\u0c38\u0c4d\u0c1f\u0c2e\u0c4d \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d\u0c32\u0c41 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47. \u0c06\u0c28\u0c4d\u0c03 API \u0c2e\u0c30\u0c3f\u0c2f\u0c41 MCP \u0c15\u0c28\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c38\u0c3f\u0c38\u0c4d\u0c1f\u0c2e\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41-\u0c07\u0c28\u0c4d\u0c38\u0c4d\u0c1f\u0c3e\u0c32\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 CA \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c48\u0c1f\u0c4d\u0c32\u0c41. \u0c39\u0c4b\u0c38\u0c4d\u0c1f\u0c4d\u0c2a\u0c47\u0c30\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u093f\u0915\u0947\u091f \u0c24\u0c28\u0c3f\u0c16\u0c40\u0c32\u0c41 \u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c40 \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c4d\u0c21\u0c3e\u0c2f\u0c3f. CA \u0c28\u0c3f \u0c07\u0c28\u0c4d\u0c38\u0c4d\u0c1f\u0c3e\u0c32\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c32\u0c47\u0c26\u0c3e \u0c24\u0c40\u0c38\u0c3f\u0c35\u0c47\u0c38\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c05\u0c28\u0c41\u0c35\u0c30\u0c4d\u0c24\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c41\u0c28\u0c03\u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",
  "Older tool replies may only include the final request's usage.": "\u0c2a\u0c3e\u0c24 \u0c1f\u0c42\u0c32\u0c4d \u0c38\u0c2e\u0c3e\u0c27\u0c3e\u0c28\u0c3e\u0c32\u0c32\u0c4b \u0c24\u0c41\u0c26\u0c3f \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28 \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c02 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c09\u0c02\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",
  "Output tokens": "\u0c05\u0c35\u0c41\u0c1f\u0c4d\u0c2a\u0c41\u0c1f\u0c4d \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d\u0c32\u0c41",
  "Partial: totals include only known counts. Some requests are unfinished or have missing usage.": "\u0c2a\u0c3e\u0c15\u0c4d\u0c37\u0c3f\u0c15\u0c03 \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c38\u0c02\u0c16\u0c4d\u0c2f\u0c32\u0c41 \u0c24\u0c46\u0c32\u0c3f\u0c38\u0c3f\u0c28 \u0c38\u0c02\u0c16\u0c4d\u0c2f\u0c32\u0c28\u0c41 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c15\u0c32\u0c3f\u0c17\u0c3f \u0c09\u0c02\u0c1f\u0c3e\u0c2f\u0c3f. \u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c32\u0c41 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c35\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c02 \u0c32\u0c47\u0c26\u0c41.",
  "Pause": "\u0c35\u0c3f\u0c30\u0c3e\u0c2e\u0c02",
  "Penalty": "\u0c36\u0c3f\u0c15\u0c4d\u0c37",
  "Play": "\u0c06\u0c21\u0c1f\u0c02",
  "Port": "\u0c28\u0c4c\u0c15\u0c3e\u0c36\u0c4d\u0c30\u0c2f\u0c02",
  "Presence penalty": "\u0c09\u0c28\u0c3f\u0c15\u0c3f\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28\u0c35\u0c3e\u0c30\u0c3f\u0c2a\u0c48 \u0c1c\u0c30\u0c3f\u0c2e\u0c3e\u0c28\u0c3e",
  "Preset name": "\u0c2a\u0c4d\u0c30\u0c40\u0c38\u0c46\u0c1f\u0c4d \u0c2a\u0c47\u0c30\u0c41",
  "Preset options": "\u0c2a\u0c4d\u0c30\u0c40\u0c38\u0c46\u0c1f\u0c4d \u0c0e\u0c02\u0c2a\u0c3f\u0c15\u0c32\u0c41",
  "Previous branch": "\u0c2a\u0c42\u0c30\u0c4d\u0c35 \u0c36\u0c3e\u0c16",
  "Properties": "\u0c06\u0c38\u0c4d\u0c24\u0c41\u0c32\u0c41",
  "Read a file linked to the chat.": "\u0c1a\u0c3e\u0c1f\u0c4d\u0c15\u0c41 \u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c2b\u0c48\u0c32\u0c4d\u0c28\u0c41 \u0c1a\u0c26\u0c35\u0c02\u0c21\u0c3f.",
  "Read file": "\u0c2b\u0c48\u0c32\u0c4d \u0c1a\u0c26\u0c35\u0c02\u0c21\u0c3f",
  "Reads a web page.": "\u0c12\u0c15 \u0c35\u0c46\u0c2c\u0c4d \u0c2a\u0c47\u0c1c\u0c40 \u0c1a\u0c26\u0c41\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",
  "Refresh models": "\u0c30\u0c3f\u0c2b\u0c4d\u0c30\u0c46\u0c37\u0c4d \u0c28\u0c2e\u0c42\u0c28\u0c3e\u0c32\u0c41",
  "Refresh tools": "\u0c30\u0c3f\u0c2b\u0c4d\u0c30\u0c46\u0c37\u0c4d \u0c38\u0c3e\u0c27\u0c28\u0c3e\u0c32\u0c41",
  "Regenerate": "\u0c2a\u0c41\u0c28\u0c30\u0c41\u0c24\u0c4d\u0c2a\u0c24\u0c4d\u0c24\u0c3f",
  "Remove": "\u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c41",
  "Remove {0}": "{0} \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c41",
  "Remove {0} call": "{0} \u0c15\u0c3e\u0c32\u0c4d \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c41",
  "Rename": "\u0c2a\u0c47\u0c30\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c41",
  "Rename conversation": "\u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23 \u0c2a\u0c47\u0c30\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c41",
  "Rename preset": "\u0c2a\u0c47\u0c30\u0c41\u0c28\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c41",
  "Replace or append to a file linked to the chat.": "\u0c1a\u0c3e\u0c1f\u0c4d\u0c15\u0c41 \u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c2b\u0c48\u0c32\u0c4d\u0c28\u0c41 \u0c2d\u0c30\u0c4d\u0c24\u0c40 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",
  "Replace passages in a file linked to the chat.": "\u0c1a\u0c3e\u0c1f\u0c4d\u0c15\u0c41 \u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c2b\u0c48\u0c32\u0c4d\u0c32\u0c4b\u0c28\u0c3f \u0c2d\u0c3e\u0c17\u0c3e\u0c32\u0c28\u0c41 \u0c2d\u0c30\u0c4d\u0c24\u0c40 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",
  "Replaces an existing preset": "\u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c47 \u0c09\u0c28\u0c4d\u0c28 \u0c2a\u0c4d\u0c30\u0c40\u0c38\u0c46\u0c1f\u0c4d\u0c28\u0c41 \u0c2d\u0c30\u0c4d\u0c24\u0c40 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f",
  "Requests with complete usage \u00b7 {0} / {1}": "\u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c32\u0c41 \u00b7 {0} / {1}",
  "Result": "\u0c2b\u0c32\u0c3f\u0c24\u0c02",
  "Revise": "\u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c41",
  "Revise message": "\u0c38\u0c02\u0c26\u0c47\u0c36\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c41",
  "Rolls like 2d6 or 1d20+5.": "2d6 \u0c32\u0c47\u0c26\u0c3e 1d20+5 \u0c35\u0c02\u0c1f\u0c3f \u0c30\u0c4b\u0c32\u0c4d\u0c38\u0c4d.",
  "Run tools without asking.": "\u0c05\u0c21\u0c17\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c1f\u0c42\u0c32\u0c4d\u0c38\u0c4d \u0c05\u0c2e\u0c32\u0c41.",
  "Running\u2026": "\u0c28\u0c21\u0c41\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28.",
  "Runs code in a sandbox.": "\u0c12\u0c15 \u0c07\u0c38\u0c41\u0c15 \u0c2c\u0c3e\u0c15\u0c4d\u0c38\u0c4d \u0c32\u0c4b \u0c15\u0c4b\u0c21\u0c4d \u0c28\u0c21\u0c41\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",
  "Sample from the top K tokens.": "\u0c1f\u0c3e\u0c2a\u0c4d K \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c28\u0c2e\u0c42\u0c28\u0c3e.",
  "Sampling": "\u0c28\u0c2e\u0c42\u0c28\u0c3e \u0c38\u0c47\u0c15\u0c30\u0c23",
  "Save": "\u0c38\u0c47\u0c35\u0c4d \u0c1a\u0c47\u0c2f\u0c3f",
  "Save a copy": "\u0c15\u0c3e\u0c2a\u0c40\u0c28\u0c3f \u0c38\u0c47\u0c35\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",
  "Save current endpoint": "\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24 \u0c0e\u0c02\u0c21\u0c4d \u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u0c28\u0c41 \u0c38\u0c47\u0c35\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",
  "Save endpoint": "\u0c0e\u0c02\u0c21\u0c4d \u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u0c28\u0c41 \u0c38\u0c47\u0c35\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",
  "Saved endpoints": "\u0c38\u0c47\u0c35\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c0e\u0c02\u0c21\u0c4d \u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u0c32\u0c41",
  "Scan": "\u0c38\u0c4d\u0c15\u0c3e\u0c28\u0c3f\u0c02\u0c17\u0c4d",
  "Scan for endpoint": "\u0c0e\u0c02\u0c21\u0c4d \u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c38\u0c4d\u0c15\u0c3e\u0c28\u0c4d",
  "Scan options": "\u0c38\u0c4d\u0c15\u0c3e\u0c28\u0c4d \u0c0e\u0c02\u0c2a\u0c3f\u0c15\u0c32\u0c41",
  "Scroll long messages": "\u0c38\u0c41\u0c26\u0c40\u0c30\u0c4d\u0c18 \u0c38\u0c02\u0c26\u0c47\u0c36\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c4b\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",
  "Search file": "\u0c36\u0c4b\u0c27\u0c28 \u0c2b\u0c48\u0c32\u0c4d",
  "Search languages": "\u0c36\u0c4b\u0c27\u0c28 \u0c2d\u0c3e\u0c37\u0c32\u0c41",
  "Select": "\u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",
  "Select a model": "\u0c28\u0c2e\u0c42\u0c28\u0c3e\u0c28\u0c41 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",
  "Select image": "\u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c02 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",
  "Select model": "\u0c28\u0c2e\u0c42\u0c28\u0c3e\u0c28\u0c41 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",
  "Selected": "\u0c0e\u0c02\u0c2a\u0c3f\u0c15",
  "Send": "\u0c2a\u0c02\u0c2a\u0c41",
  "Settings": "\u0c38\u0c46\u0c1f\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c41",
  "Show reasoning": "\u0c24\u0c3e\u0c30\u0c4d\u0c15\u0c3f\u0c15\u0c24 \u0c1a\u0c42\u0c2a\u0c3f\u0c02\u0c1a\u0c41",
  "Show tool calls": "\u0c1f\u0c42\u0c32\u0c4d \u0c15\u0c3e\u0c32\u0c4d\u0c38\u0c4d \u0c1a\u0c42\u0c2a\u0c3f\u0c02\u0c1a\u0c41",
  "Show tool result": "\u0c38\u0c3e\u0c27\u0c28\u0c02 \u0c2b\u0c32\u0c3f\u0c24\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c1a\u0c42\u0c2a\u0c3f\u0c02\u0c1a\u0c41",
  "Subnet": "\u0c38\u0c2c\u0c4d \u0c28\u0c46\u0c1f\u0c4d",
  "System": "\u0c35\u0c4d\u0c2f\u0c35\u0c38\u0c4d\u0c25",
  "System default": "\u0c35\u0c4d\u0c2f\u0c35\u0c38\u0c4d\u0c25 \u0c21\u0c3f\u0c2b\u0c3e\u0c32\u0c4d\u0c1f\u0c4d",
  "System prompt": "\u0c35\u0c4d\u0c2f\u0c35\u0c38\u0c4d\u0c25 \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c2a\u0c4d\u0c1f\u0c4d",
  "Tags": "\u0c1f\u0c4d\u0c2f\u0c3e\u0c17\u0c4d\u0c32\u0c41",
  "Temperature": "\u0c09\u0c37\u0c4d\u0c23\u0c4b\u0c17\u0c4d\u0c30\u0c24",
  "Text file": "\u0c1f\u0c46\u0c15\u0c4d\u0c38\u0c4d\u0c1f\u0c4d \u0c2b\u0c48\u0c32\u0c4d",
  "The conversation has grown since it was last counted; the next reply will update it.": "\u0c1a\u0c3f\u0c35\u0c30\u0c3f\u0c38\u0c3e\u0c30\u0c3f\u0c17\u0c3e \u0c32\u0c46\u0c15\u0c4d\u0c15\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23 \u0c2a\u0c46\u0c30\u0c3f\u0c17\u0c3f\u0c02\u0c26\u0c3f; \u0c24\u0c26\u0c41\u0c2a\u0c30\u0c3f \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c38\u0c4d\u0c2a\u0c02\u0c26\u0c28 \u0c26\u0c3e\u0c28\u0c3f\u0c28\u0c3f \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",
  "The conversation has shrunk since it was last counted; the next reply will update it.": "\u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23 \u0c1a\u0c3f\u0c35\u0c30\u0c3f\u0c38\u0c3e\u0c30\u0c3f\u0c17\u0c3e \u0c32\u0c46\u0c15\u0c4d\u0c15\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c24\u0c17\u0c4d\u0c17\u0c3f\u0c2a\u0c4b\u0c2f\u0c3f\u0c02\u0c26\u0c3f; \u0c24\u0c26\u0c41\u0c2a\u0c30\u0c3f \u0c38\u0c2e\u0c3e\u0c27\u0c3e\u0c28\u0c02 \u0c26\u0c3e\u0c28\u0c3f\u0c28\u0c3f \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",
  "The local subnet is probed on this port for an OpenAI-compatible endpoint.": "\u0c08 \u0c2a\u0c4b\u0c30\u0c4d\u0c1f\u0c41\u0c32\u0c4b \u0c13\u0c2a\u0c46\u0c28\u0c4d\u0c0f\u0c10 \u0c05\u0c28\u0c41\u0c15\u0c42\u0c32\u0c2e\u0c48\u0c28 \u0c0e\u0c02\u0c21\u0c4d \u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3f\u0c15 \u0c38\u0c2c\u0c4d \u0c28\u0c46\u0c1f\u0c4d\u0c28\u0c41 \u0c38\u0c30\u0c4d\u0c35\u0c47 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c41.",
  "The saved token can't be decrypted. Enter it again.": "\u0c38\u0c47\u0c35\u0c4d \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d \u0c21\u0c40\u0c15\u0c4d\u0c30\u0c3f\u0c2a\u0c4d\u0c1f\u0c4d \u0c38\u0c3e\u0c27\u0c4d\u0c2f\u0c02 \u0c15\u0c3e\u0c26\u0c41. \u0c2e\u0c33\u0c4d\u0c33\u0c40 \u0c28\u0c2e\u0c4b\u0c26\u0c41.",
  "The server did not report a context capacity.": "\u0c38\u0c30\u0c4d\u0c35\u0c30\u0c4d \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c2d \u0c38\u0c3e\u0c2e\u0c30\u0c4d\u0c25\u0c4d\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c02\u0c1a\u0c32\u0c47\u0c26\u0c41.",
  "The server lists no tools.": "\u0c38\u0c30\u0c4d\u0c35\u0c30\u0c4d \u0c1f\u0c42\u0c32\u0c4d\u0c38\u0c4d \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e \u0c32\u0c47\u0c26\u0c41.",
  "The stored API key can no longer be decrypted on this device. Enter it again to replace it.": "\u0c08 \u0c2a\u0c30\u0c3f\u0c15\u0c30\u0c02\u0c32\u0c4b \u0c28\u0c3f\u0c32\u0c4d\u0c35 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 API \u0c15\u0c40 \u0c07\u0c15\u0c2a\u0c48 \u0c21\u0c40\u0c15\u0c4d\u0c30\u0c3f\u0c2a\u0c4d\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c26\u0c41. \u0c26\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2d\u0c30\u0c4d\u0c24\u0c40 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c26\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",
  "Theme": "\u0c25\u0c40\u0c2e\u0c4d",
  "Thinking": "\u0c06\u0c32\u0c4b\u0c1a\u0c3f\u0c02\u0c1a\u0c21\u0c02",
  "This file is no longer available.": "\u0c08 \u0c2b\u0c48\u0c32\u0c4d \u0c07\u0c15\u0c2a\u0c48 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c32\u0c47\u0c26\u0c41.",
  "Time to first token": "\u0c2e\u0c4a\u0c26\u0c1f\u0c3f \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d \u0c38\u0c2e\u0c2f\u0c02",
  "Token can't be decrypted \u2014 enter it again": "\u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d \u0c21\u0c40\u0c15\u0c4d\u0c30\u0c3f\u0c2a\u0c4d\u0c1f\u0c4d \u0c38\u0c3e\u0c27\u0c4d\u0c2f\u0c02 \u0c15\u0c3e\u0c26\u0c41  \u2047  \u0c26\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2e\u0c33\u0c4d\u0c33\u0c40 \u0c28\u0c2e\u0c4b\u0c26\u0c41",
  "Token usage pending": "\u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c02",
  "Token usage unavailable": "\u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c02 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c32\u0c47\u0c26\u0c41",
  "Token usage \u00b7 active branch": "\u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c02 \u00b7 \u0c15\u0c4d\u0c30\u0c3f\u0c2f\u0c3e\u0c36\u0c40\u0c32 \u0c36\u0c3e\u0c16",
  "Token usage \u00b7 saved history": "\u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c02 \u00b7 \u0c38\u0c47\u0c35\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c1a\u0c30\u0c3f\u0c24\u0c4d\u0c30",
  "Tool calls \u00b7 {0}": "{0} \u0c38\u0c3e\u0c27\u0c28 \u0c15\u0c3e\u0c32\u0c4d\u0c38\u0c4d",
  "Tools": "\u0c38\u0c3e\u0c27\u0c28\u0c3e\u0c32\u0c41",
  "Tools are prefixed with {0}__": "\u0c38\u0c3e\u0c27\u0c28\u0c3e\u0c32\u0c41 {0}__ \u0c24\u0c4b \u0c2e\u0c41\u0c02\u0c26\u0c38\u0c4d\u0c24\u0c41\u0c17\u0c3e \u0c09\u0c02\u0c1f\u0c3e\u0c2f\u0c3f",
  "Tools \u00b7 {0}": "\u0c38\u0c3e\u0c27\u0c28\u0c3e\u0c32\u0c41 \u00b7 {0}",
  "Top": "\u0c0e\u0c17\u0c41\u0c35",
  "Top K": "\u0c1f\u0c3e\u0c2a\u0c4d K",
  "Top P": "\u0c1f\u0c3e\u0c2a\u0c4d \u0c2a\u0c3f",
  "Total": "\u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02",
  "Total tokens": "\u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d\u0c32\u0c41",
  "Total \u00b7 {0} tokens": "\u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u00b7 {0} \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d\u0c32\u0c41",
  "Trust this server": "\u0c08 \u0c38\u0c30\u0c4d\u0c35\u0c30\u0c4d \u0c28\u0c2e\u0c4d\u0c2e\u0c02\u0c21\u0c3f",
  "Trust user-installed certificates": "\u0c1f\u0c4d\u0c30\u0c38\u0c4d\u0c1f\u0c4d \u0c2f\u0c42\u0c1c\u0c30\u0c4d \u0c07\u0c28\u0c4d\u0c38\u0c4d\u0c1f\u0c3e\u0c32\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c38\u0c30\u0c4d\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c1f\u0c4d\u0c32\u0c41",
  "Twilight": "\u0c38\u0c42\u0c30\u0c4d\u0c2f\u0c4b\u0c26\u0c2f\u0c02",
  "Unencrypted HTTP. Only enable on trusted networks. Local servers may need this.": "\u0c0e\u0c28\u0c4d\u0c15\u0c4d\u0c30\u0c3f\u0c2a\u0c4d\u0c1f\u0c46\u0c21\u0c4d HTTP. \u0c35\u0c3f\u0c36\u0c4d\u0c35\u0c38\u0c28\u0c40\u0c2f \u0c28\u0c46\u0c1f\u0c4d\u0c35\u0c30\u0c4d\u0c15\u0c4d\u0c32\u0c32\u0c4b \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c0e\u0c28\u0c47\u0c2c\u0c41\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3f\u0c15 \u0c38\u0c30\u0c4d\u0c35\u0c30\u0c4d\u0c32\u0c15\u0c41 \u0c07\u0c26\u0c3f \u0c05\u0c35\u0c38\u0c30\u0c02 \u0c15\u0c3e\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",
  "Unencrypted: trusted networks only": "\u0c17\u0c41\u0c2a\u0c4d\u0c24\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c32\u0c47\u0c26\u0c41\u0c03 \u0c35\u0c3f\u0c36\u0c4d\u0c35\u0c38\u0c28\u0c40\u0c2f \u0c28\u0c46\u0c1f\u0c4d\u0c35\u0c30\u0c4d\u0c15\u0c4d\u0c32\u0c41 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47",
  "Unlink {0}": "\u0c32\u0c3f\u0c02\u0c15\u0c4d\u0c28\u0c41 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c41 {0}",
  "Updating as the server reports usage. Some servers only report it when a reply finishes.": "\u0c38\u0c30\u0c4d\u0c35\u0c30\u0c4d \u0c35\u0c3e\u0c21\u0c41\u0c15\u0c28\u0c41 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c28\u0c4d\u0c28\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c30\u0c4d\u0c35\u0c30\u0c4d\u0c32\u0c41 \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c38\u0c4d\u0c2a\u0c02\u0c26\u0c28 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c2f\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f.",
  "Usage sums API requests, including tool continuations and repeated input history. Missing or interrupted records remain partial. Deleted replies are excluded; this is not a billing ledger.": "\u0c1f\u0c42\u0c32\u0c4d \u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c3f\u0c02\u0c2a\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c41\u0c28\u0c30\u0c3e\u0c35\u0c43\u0c24 \u0c07\u0c28\u0c4d\u0c2a\u0c41\u0c1f\u0c4d \u0c1a\u0c30\u0c3f\u0c24\u0c4d\u0c30\u0c24\u0c4b \u0c38\u0c39\u0c3e API \u0c05\u0c2d\u0c4d\u0c2f\u0c30\u0c4d\u0c25\u0c28\u0c32\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02. \u0c24\u0c2a\u0c4d\u0c2a\u0c3f\u0c2a\u0c4b\u0c2f\u0c3f\u0c28 \u0c32\u0c47\u0c26\u0c3e \u0c05\u0c02\u0c24\u0c30\u0c3e\u0c2f\u0c2a\u0c21\u0c3f\u0c28 \u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32\u0c41 \u0c2a\u0c3e\u0c15\u0c4d\u0c37\u0c3f\u0c15\u0c02\u0c17\u0c3e \u0c09\u0c02\u0c1f\u0c3e\u0c2f\u0c3f. \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c38\u0c2e\u0c3e\u0c27\u0c3e\u0c28\u0c3e\u0c32\u0c41 \u0c2e\u0c3f\u0c28\u0c39\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c4d\u0c21\u0c3e\u0c2f\u0c3f; \u0c07\u0c26\u0c3f \u0c2c\u0c3f\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c17\u0c4d \u0c32\u0c46\u0c21\u0c4d\u0c1c\u0c30\u0c4d \u0c15\u0c3e\u0c26\u0c41.",
  "Use scroll view": "\u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c4b\u0c32\u0c4d \u0c35\u0c40\u0c15\u0c4d\u0c37\u0c23\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "User": "\u0c35\u0c3e\u0c21\u0c41\u0c15\u0c30\u0c3f",
  "Uses the first message locally; keeps manually chosen titles and uses no extra tokens.": "\u0c2e\u0c4a\u0c26\u0c1f\u0c3f \u0c38\u0c02\u0c26\u0c47\u0c36\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c3f\u0c15\u0c02\u0c17\u0c3e \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f; \u0c1a\u0c47\u0c24\u0c3f\u0c24\u0c4b \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c41\u0c28\u0c4d\u0c28 \u0c36\u0c40\u0c30\u0c4d\u0c37\u0c3f\u0c15\u0c32\u0c28\u0c41 \u0c09\u0c02\u0c1a\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c26\u0c28\u0c2a\u0c41 \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d\u0c32\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c26\u0c41.",
  "Write access": "\u0c2f\u0c3e\u0c15\u0c4d\u0c38\u0c46\u0c38\u0c4d \u0c35\u0c4d\u0c30\u0c3e\u0c2f\u0c02\u0c21\u0c3f",
  "Write file": "\u0c2b\u0c48\u0c32\u0c4d \u0c35\u0c4d\u0c30\u0c3e\u0c2f\u0c02\u0c21\u0c3f",
  "Writes": "\u0c30\u0c1a\u0c28\u0c32\u0c41",
  "Your name": "\u0c2e\u0c40 \u0c2a\u0c47\u0c30\u0c41",
  "Your profile picture": "\u0c2e\u0c40 \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c2b\u0c4b\u0c1f\u0c4b",
  "stopped": "\u0c06\u0c17\u0c3f\u0c2a\u0c4b\u0c2f\u0c3f\u0c02\u0c26\u0c3f",
  "{0} addresses probed": "{0} \u0c38\u0c30\u0c4d\u0c35\u0c47 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e\u0c32\u0c41",
  "\u2248 is an estimate of the current branch and draft. Tokenization, tool schemas and media can change the actual count.": "\u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c3f\u0c1c\u0c47\u0c37\u0c28\u0c4d, \u0c1f\u0c42\u0c32\u0c4d \u0c38\u0c4d\u0c15\u0c40\u0c2e\u0c4d\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c40\u0c21\u0c3f\u0c2f\u0c3e \u0c35\u0c3e\u0c38\u0c4d\u0c24\u0c35 \u0c38\u0c02\u0c16\u0c4d\u0c2f\u0c28\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c17\u0c32\u0c35\u0c41.",
  "Search models ({0})": "\u0c36\u0c4b\u0c27\u0c28 \u0c28\u0c2e\u0c42\u0c28\u0c3e\u0c32\u0c41 ({0})",
  "Collapse message": "\u0c38\u0c02\u0c26\u0c47\u0c36\u0c02 \u0c15\u0c41\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "Expand message": "\u0c38\u0c02\u0c26\u0c47\u0c36\u0c02 \u0c35\u0c3f\u0c38\u0c4d\u0c24\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "Start Chat Session": "\u0c1a\u0c3e\u0c1f\u0c4d \u0c38\u0c46\u0c37\u0c28\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "Endpoint Switch": "\u0c0e\u0c02\u0c21\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c02\u0c21\u0c3f",
  "Auto-collapse messages": "\u0c38\u0c02\u0c26\u0c47\u0c36\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c1a\u0c3e\u0c32\u0c15\u0c02\u0c17\u0c3e \u0c15\u0c41\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "Select chats": "\u0c1a\u0c3e\u0c1f\u0c4d\u0c32\u0c28\u0c41 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",
  "selected": "\u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c41\u0c28\u0c4d\u0c28\u0c26\u0c3f",
  "Select all": "\u0c05\u0c28\u0c4d\u0c28\u0c40 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",
  "Deselect all": "\u0c05\u0c28\u0c4d\u0c28\u0c40 \u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",
  "Done": "\u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c2f\u0c3f\u0c02\u0c26\u0c3f",
  "In-app UI scale": "In-app UI scale"
}