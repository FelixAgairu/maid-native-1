  "Conversation token usage": "\u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23 \u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c02",
