  "Enter a port between 1 and 65535": "\u0395\u03b9\u03c3\u03ac\u03b3\u03b5\u03c4\u03b5 \u03bc\u03b9\u03b1 \u03c0\u03cd\u03bb\u03b7 \u03bc\u03b5\u03c4\u03b1\u03be\u03cd 1 \u03ba\u03b1\u03b9 65535",
  "Enter an http or https URL": "\u0395\u03b9\u03c3\u03ac\u03b3\u03b5\u03c4\u03b5 URL http \u03ae https",
  "Expand all": "\u0395\u03c0\u03b5\u03be\u03b5\u03c4\u03ac\u03c3\u03c4\u03b5 \u03cc\u03bb\u03b1",
