  "Export all": "\u0395\u03be\u03b1\u03b3\u03c9\u03b3\u03ae \u03cc\u03bb\u03c9\u03bd",
  "Export media": "\u039c\u03ad\u03c3\u03b1 \u03b5\u03be\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2",
  "Fades out while you type. Images are cropped to the pill and copied into the app.": "\u039f\u03b9 \u03b5\u03b9\u03ba\u03cc\u03bd\u03b5\u03c2 \u03ba\u03cc\u03b2\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf \u03c7\u03ac\u03c0\u03b9 \u03ba\u03b1\u03b9 \u03b1\u03bd\u03c4\u03b9\u03b3\u03c1\u03ac\u03c6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae.",
  "Fetch URL": "\u03a6\u03ad\u03c1\u03c4\u03b5 \u03c4\u03bf URL",
  "Files": "\u0391\u03c1\u03c7\u03b5\u03af\u03b1",
  "Find text in a file linked to the chat.": "\u0392\u03c1\u03b5\u03c2 \u03ba\u03b5\u03af\u03bc\u03b5\u03bd\u03bf \u03c3\u03b5 \u03b1\u03c1\u03c7\u03b5\u03af\u03bf \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b4\u03ad\u03b5\u03c4\u03b1\u03b9 \u03bc\u03b5 \u03c4\u03b7\u03bd \u03c3\u03c5\u03bd\u03bf\u03bc\u03b9\u03bb\u03af\u03b1.",
  "Frequency penalty": "\u0397 \u03c0\u03bf\u03b9\u03bd\u03ae \u03c3\u03c5\u03c7\u03bd\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2",
  "Hide reasoning": "\u039a\u03c1\u03cd\u03c8\u03c4\u03b5 \u03c4\u03b7 \u03bb\u03bf\u03b3\u03b9\u03ba\u03ae",
  "Hide tool calls": "\u039a\u03c1\u03cd\u03c8\u03c4\u03b5 \u03c4\u03b9\u03c2 \u03ba\u03bb\u03ae\u03c3\u03b5\u03b9\u03c2 \u03b5\u03c1\u03b3\u03b1\u03bb\u03b5\u03af\u03c9\u03bd",
  "Hide tool result": "\u039a\u03c1\u03cd\u03c8\u03c4\u03b5 \u03c4\u03bf \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03b5\u03c1\u03b3\u03b1\u03bb\u03b5\u03af\u03bf\u03c5",
  "Higher is more random.": "\u03a4\u03bf \u03c5\u03c8\u03b7\u03bb\u03cc\u03c4\u03b5\u03c1\u03bf \u03b5\u03af\u03bd\u03b1\u03b9 \u03c0\u03b9\u03bf \u03c4\u03c5\u03c7\u03b1\u03af\u03bf.",
  "Image": "\u0395\u03b9\u03ba\u03cc\u03bd\u03b1",
  "Import": "\u0395\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae",
