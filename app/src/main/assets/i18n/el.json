  "Delete message": "\u0394\u03b9\u03b1\u03b3\u03c1\u03ac\u03c8\u03c4\u03b5 \u03bc\u03ae\u03bd\u03c5\u03bc\u03b1",
  "Delete preset": "\u0394\u03b9\u03b1\u03b3\u03c1\u03ac\u03c8\u03c4\u03b5 \u03c4\u03bf \u03c0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf",
  "Delete server": "\u0394\u03b9\u03b1\u03b3\u03c1\u03ac\u03c8\u03c4\u03b5 \u03c4\u03bf\u03bd \u03b4\u03b9\u03b1\u03ba\u03bf\u03bc\u03b9\u03c3\u03c4\u03ae",
  "Delete this conversation permanently? This can't be undone.": "\u039d\u03b1 \u03b4\u03b9\u03b1\u03b3\u03c1\u03ac\u03c8\u03b5\u03b9\u03c2 \u03b1\u03c5\u03c4\u03ae \u03c4\u03b7 \u03c3\u03c5\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7 \u03bc\u03cc\u03bd\u03b9\u03bc\u03b1;",
  "Delete this message and everything below it? This can't be undone.": "\u039d\u03b1 \u03b4\u03b9\u03b1\u03b3\u03c1\u03ac\u03c8\u03b5\u03b9\u03c2 \u03b1\u03c5\u03c4\u03cc \u03c4\u03bf \u03bc\u03ae\u03bd\u03c5\u03bc\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03b1 \u03c0\u03ac\u03bd\u03c4\u03b1 \u03ba\u03ac\u03c4\u03c9 \u03b1\u03c0\u03cc \u03b1\u03c5\u03c4\u03cc;",
  "Deny": "\u0391\u03c1\u03bd\u03b7\u03c4\u03b9\u03ba\u03ae",
  "Dialog": "\u0394\u03b9\u03ac\u03bb\u03bf\u03b3\u03bf",
  "Dice roller": "\u03a1\u03bf\u03bb\u03cc\u03bd\u03b9 \u03b6\u03b1\u03c7\u03b1\u03c1\u03c9\u03c4\u03ce\u03bd",
  "Discourages frequent repeats.": "\u0391\u03c0\u03bf\u03b8\u03b1\u03c1\u03c1\u03cd\u03bd\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03c3\u03c5\u03c7\u03bd\u03ad\u03c2 \u03b5\u03c0\u03b1\u03bd\u03b1\u03bb\u03ae\u03c8\u03b5\u03b9\u03c2.",
  "Don't ask again": "\u039c\u03b7\u03bd \u03c1\u03c9\u03c4\u03ac\u03c2 \u03be\u03b1\u03bd\u03ac.",
  "Edit MCP server": "\u03a4\u03c1\u03bf\u03c0\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03c4\u03b5 MCP server",
  "Edit file": "\u03a4\u03c1\u03bf\u03c0\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03b1\u03c1\u03c7\u03b5\u03af\u03bf\u03c5",
  "Edit message": "\u03a4\u03c1\u03bf\u03c0\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03c4\u03b5 \u03bc\u03ae\u03bd\u03c5\u03bc\u03b1",
  "Edit system prompt": "\u03a4\u03c1\u03bf\u03c0\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c3\u03c5\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2",
  "Endpoint": "\u03a4\u03b5\u03bb\u03b9\u03ba\u03cc \u03c3\u03b7\u03bc\u03b5\u03af\u03bf",
