  "Endpoint Switch": "\u05d4\u05d7\u05dc\u05e3 \u05e0\u05e7\u05d5\u05d3\u05ea \u05e7\u05e6\u05d4",
  "Auto-collapse messages": "\u05db\u05d5\u05d5\u05e5 \u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea",
