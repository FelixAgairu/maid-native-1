  "Export media": "\u0415\u043a\u0441\u043f\u043e\u0440\u0442\u043d\u0456 \u0437\u0430\u0441\u043e\u0431\u0438",
  "Fades out while you type. Images are cropped to the pill and copied into the app.": "\u0406\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u0440\u0456\u0437\u0430\u044e\u0442\u044c\u0441\u044f \u0434\u043e \u0442\u0430\u0431\u043b\u0435\u0442\u043a\u0438 \u0456 \u043a\u043e\u043f\u0456\u044e\u044e\u0442\u044c\u0441\u044f \u0432 \u0434\u043e\u0434\u0430\u0442\u043e\u043a.",
  "Fetch URL": "\u0414\u043e\u0432\u0435\u0434\u0456\u0442\u044c URL",
  "Files": "\u0424\u0430\u0439\u043b\u0438",
  "Find text in a file linked to the chat.": "\u0417\u043d\u0430\u0439\u0434\u0456\u0442\u044c \u0442\u0435\u043a\u0441\u0442 \u0443 \u0444\u0430\u0439\u043b\u0456, \u043f\u043e\u0432'\u044f\u0437\u0430\u043d\u043e\u043c\u0443 \u0437 \u0447\u0430\u0442\u043e\u043c.",
  "Frequency penalty": "\u0427\u0430\u0441\u0442\u043e\u0442\u0430 \u0448\u0442\u0440\u0430\u0444\u0443",
  "Hide reasoning": "\u041f\u043e\u043a\u0440\u0438\u0442\u0438 \u0440\u043e\u0437\u0441\u0443\u0434",
  "Hide tool calls": "\u0421\u043a\u0440\u0438\u0442\u0438 \u0434\u0437\u0432\u0456\u043d\u043a\u0438 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430",
  "Hide tool result": "\u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0443 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u0442\u0438",
  "Higher is more random.": "\u0412\u0438\u0449\u043e - \u0446\u0435 \u0431\u0456\u043b\u044c\u0448 \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u043e.",
  "Image": "\u0424\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0456\u044f",
  "Import": "\u0406\u043c\u043f\u043e\u0440\u0442",
  "In use": "\u0423 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u0456",
  "In {0} \u00b7 Out {1}": "\u0412 {0} \u00b7 \u0412 {1}",
  "In {0} \u00b7 Out {1} \u00b7 {2} {3} tokens": "\u0423 {0} \u00b7 Out {1} \u00b7 {2} {3} \u0442\u043e\u043a\u0435\u043d\u0456\u0432",
  "Includes attached images and audio in exported conversations.": "\u0412\u043a\u043b\u044e\u0447\u0430\u0454 \u043f\u0440\u0438\u0454\u0434\u043d\u0430\u043d\u0456 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u0442\u0430 \u0430\u0443\u0434\u0456\u043e \u0432 \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u0438\u0445 \u0440\u043e\u0437\u043c\u043e\u0432\u0430\u0445.",
  "Input includes history sent again on each request. This is usage, not the number of tokens currently in the model's context window.": "\u0412\u0445\u0456\u0434 \u0432\u043a\u043b\u044e\u0447\u0430\u0454 \u0432 \u0441\u0435\u0431\u0435 \u0456\u0441\u0442\u043e\u0440\u0456\u044e, \u0449\u043e \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u0432\u0456\u0434\u043f\u0440\u0430\u0432\u043b\u044f\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u043a\u043e\u0436\u043d\u0443 \u0437\u0430\u043f\u0438\u0442. \u0426\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f, \u0430 \u043d\u0435 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0442\u043e\u043a\u0435\u043d\u0456\u0432, \u0449\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u044f\u0442\u044c\u0441\u044f \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443 \u0432\u0456\u043a\u043d\u0430 \u043c\u043e\u0434\u0435\u043b\u0456.",
  "Input tokens": "\u0412\u0445\u0456\u0434\u043d\u0456 \u0442\u043e\u043a\u0435\u043d\u0456",
  "Input \u00b7 {0}\nOutput \u00b7 {1}": "\u0412\u0445\u0456\u0434 \u00b7 {0} \u0412\u0438\u0445\u0456\u0434 \u00b7 {1}",
  "JavaScript": "JavaScript",
  "Key can't be decrypted \u2014 re-save": "\u041a\u043b\u044e\u0447 \u043d\u0435 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u0440\u043e\u0437\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u0439",
  "Known total": "\u0412\u0456\u0434\u043e\u043c\u0438\u0439 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0438\u0439",
  "Known total (partial)": "\u0412\u0456\u0434\u043e\u043c\u0438\u0439 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0438\u0439 (\u0447\u0430\u0441\u0442\u0438\u0447\u043d\u0438\u0439)",
