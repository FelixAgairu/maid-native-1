  "Link files to a chat.": "\u0417'\u0454\u0434\u043d\u0430\u0442\u0438 \u0444\u0430\u0439\u043b\u0438 \u0434\u043e \u0447\u0430\u0442\u0443.",
  "Linked files": "\u0417\u0432'\u044f\u0437\u0430\u043d\u0456 \u0444\u0430\u0439\u043b\u0438",
  "List": "\u0421\u043f\u0438\u0441\u043e\u043a",
  "Local": "\u041c\u0456\u0441\u0446\u0435\u0432\u0456",
  "Long messages and reasoning scroll inside their cards. Expand any card to read it in full.": "\u0414\u043b\u0438\u043d\u043d\u0456 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u0456 \u0440\u043e\u0437\u0441\u0443\u0434\u043a\u0438 \u043f\u0440\u043e\u043a\u0440\u0443\u0447\u0443\u044e\u0442\u044c\u0441\u044f \u0432 \u0457\u0445\u043d\u0456\u0445 \u043a\u0430\u0440\u0442\u043a\u0430\u0445. \u0420\u043e\u0437\u0448\u0438\u0440\u044f\u0439\u0442\u0435 \u0431\u0443\u0434\u044c-\u044f\u043a\u0443 \u043a\u0430\u0440\u0442\u0443, \u0449\u043e\u0431 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u0438 \u0457\u0457 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e.",
  "Media token costs are not included in the estimate.": "\u0412\u0430\u0440\u0442\u0456\u0441\u0442\u044c \u043c\u0435\u0434\u0456\u0430-\u0442\u043e\u043a\u0435\u043d\u0456\u0432 \u043d\u0435 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0430 \u0432 \u043e\u0446\u0456\u043d\u043a\u0443.",
  "Message": "\u041f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f",
  "Min P": "\u041c\u0456\u043d\u0430 \u041f",
  "Model": "\u041c\u043e\u0434\u0435\u043b\u044c",
  "Modify": "\u041c\u043e\u0434\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u044f",
  "More chat actions": "\u0411\u0456\u043b\u044c\u0448\u0435 \u0447\u0430\u0442-\u0430\u043a\u0446\u0456\u0439",
  "Must be a JSON object": "\u0426\u0435 \u043c\u0430\u0454 \u0431\u0443\u0442\u0438 \u043e\u0431'\u0454\u043a\u0442 JSON",
  "Name": "\u0406\u043c'\u044f",
  "Network": "\u041c\u0435\u0440\u0435\u0436\u0430",
  "New chat": "\u041d\u043e\u0432\u0438\u0439 \u0447\u0430\u0442",
  "New file": "\u041d\u043e\u0432\u0438\u0439 \u0444\u0430\u0439\u043b",
  "Next branch": "\u041d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u0432\u0456\u0434\u0434\u0456\u043b",
  "No API key": "\u0411\u0435\u0437 \u043a\u043b\u044e\u0447\u0430 API",
  "No chats yet": "\u0429\u0435 \u043d\u0435\u043c\u0430\u0454 \u0440\u043e\u0437\u043c\u043e\u0432.",
  "No matching models": "\u041d\u0435\u043c\u0430\u0454 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0438\u0445 \u043c\u043e\u0434\u0435\u043b\u0435\u0439",
  "No models loaded. Tap the scan button or refresh to fetch /models.": "\u041d\u0456\u044f\u043a\u0438\u0445 \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043e. \u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043a\u043d\u043e\u043f\u043a\u0443 \u0441\u043a\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0430\u0431\u043e \u043e\u043d\u043e\u0432\u043b\u044e\u0439\u0442\u0435, \u0449\u043e\u0431 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 /\u043c\u043e\u0434\u0435\u043b\u0456.",
  "None": "\u041d\u0456\u043a\u043e\u0433\u043e",
  "Nothing saved yet. A preset keeps a Base URL and its API key together, so switching endpoints takes one tap.": "\u0417\u0430\u0437\u0434\u0430\u043b\u0435\u0433\u0456\u0434\u044c \u043d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e. \u041f\u0435\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454 \u0431\u0430\u0437\u043e\u0432\u0438\u0439 URL \u0456 \u0439\u043e\u0433\u043e \u043a\u043b\u044e\u0447 API \u0440\u0430\u0437\u043e\u043c, \u0442\u043e\u043c\u0443 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f \u043a\u0456\u043d\u0446\u0435\u0432\u0438\u0445 \u0442\u043e\u0447\u043e\u043a \u0437\u0430\u0439\u043c\u0430\u0454 \u043e\u0434\u0438\u043d \u0442\u0438\u0441\u043a.",
  "Nudges toward new topics.": "\u041f\u043e\u0432\u0435\u0440\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u0434\u043e \u043d\u043e\u0432\u0438\u0445 \u0442\u0435\u043c.",
  "Off": "\u0417\u043d\u0456\u043c\u0430\u0439\u0442\u0435.",
  "Off: system certificates only. On: system and user-installed CA certificates for API and MCP connections. Hostname and certificate checks remain enabled. Restart the app after installing or removing a CA.": "\u0412\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f: \u0442\u0456\u043b\u044c\u043a\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u0438. \u0412\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f: \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0442\u0430 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0456 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0435\u043c \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u0438 CA \u0434\u043b\u044f \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u044c API \u0442\u0430 MCP. \u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0456\u043c'\u044f \u0445\u043e\u0441\u0442\u043e\u0432\u043e\u0433\u043e \u0456 \u0441\u0435\u0440\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u0443 \u0437\u0430\u043b\u0438\u0448\u0430\u0454\u0442\u044c\u0441\u044f \u0432\u0432\u0456\u0434\u043d\u043e\u044e. \u0412\u0456\u0434\u043d\u043e\u0432\u043b\u044e\u0439\u0442\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443 \u043f\u0456\u0441\u043b\u044f \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0430\u0431\u043e \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043d\u044f CA.",
  "Older tool replies may only include the final request's usage.": "\u0421\u0442\u0430\u0440\u0456 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u043d\u0430 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u043a\u043b\u044e\u0447\u0430\u0442\u0438 \u043b\u0438\u0448\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u043a\u0456\u043d\u0446\u0435\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0442\u0443.",
  "Output tokens": "\u0422\u043e\u043a\u0435\u043d\u0456\u0432 \u0432\u0438\u0445\u043e\u0434\u0443",
  "Partial: totals include only known counts. Some requests are unfinished or have missing usage.": "\u0427\u0430\u0441\u0442\u0438\u043d\u043d\u0456: \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0456 \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u044c \u043b\u0438\u0448\u0435 \u0432\u0456\u0434\u043e\u043c\u0456 \u0447\u0438\u0441\u043b\u0430. \u0414\u0435\u044f\u043a\u0456 \u0437\u0430\u043f\u0438\u0442\u0438 \u043d\u0435\u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0456 \u0430\u0431\u043e \u043d\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f.",
  "Pause": "\u041f\u0430\u0443\u0437\u0430",
  "Penalty": "\u041d\u0430\u043a\u0430\u0437\u0430\u043d\u043d\u044f",
