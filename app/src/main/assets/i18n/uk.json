  "Preset name": "\u041d\u0430\u0437\u0432\u0430 \u0437\u0430\u0437\u0434\u0430\u043b\u0435\u0433\u0456\u0434\u044c",
  "Preset options": "\u0412\u0430\u0440\u0438\u0430\u043d\u0442\u0438 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f",
  "Previous branch": "\u041f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044f \u0433\u0430\u043b\u0443\u0437\u044c",
  "Properties": "\u0421\u043e\u0431'\u0454\u0442\u0438",
  "Read a file linked to the chat.": "\u0427\u0438\u0442\u0430\u0439\u0442\u0435 \u0444\u0430\u0439\u043b, \u043f\u043e\u0432'\u044f\u0437\u0430\u043d\u0438\u0439 \u0437 \u0447\u0430\u0442\u043e\u043c.",
  "Read file": "\u0427\u0438\u0442\u0430\u0442\u0438 \u0444\u0430\u0439\u043b",
  "Reads a web page.": "\u0427\u0438\u0442\u0430\u0454 \u0432\u0435\u0431-\u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443.",
  "Refresh models": "\u041c\u043e\u0434\u0435\u043b\u0456 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f",
  "Refresh tools": "\u0406\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f",
  "Regenerate": "\u0420\u0435\u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0456\u044f",
  "Remove": "\u0412\u0438\u043b\u0443\u0447\u0438\u0442\u0438",
  "Remove {0}": "\u0417\u043d\u0456\u043c\u0456\u0442\u044c {0}",
  "Remove {0} call": "\u0417\u043d\u0456\u043c\u0456\u0442\u044c \u0437\u0430\u043a\u043b\u0438\u043a\u0430\u043d\u043d\u044f {0}",
  "Rename": "\u041f\u0435\u0440\u0435\u0439\u043c\u0435\u043d\u0443\u0432\u0430\u043d\u043d\u044f",
  "Rename conversation": "\u041f\u0435\u0440\u0435\u0439\u043c\u0456\u0442\u044c \u0440\u043e\u0437\u043c\u043e\u0432\u0443",
  "Rename preset": "\u041f\u0435\u0440\u0435\u0439\u043c\u0435\u043d\u0443\u0432\u0430\u043d\u043d\u044f",
  "Replace or append to a file linked to the chat.": "\u0417\u0430\u043c\u0456\u043d\u0438\u0442\u0438 \u0430\u0431\u043e \u0434\u043e\u0434\u0430\u0442\u0438 \u0434\u043e \u0444\u0430\u0439\u043b\u0443, \u043f\u043e\u0432'\u044f\u0437\u0430\u043d\u043e\u0433\u043e \u0437 \u0447\u0430\u0442\u043e\u043c.",
