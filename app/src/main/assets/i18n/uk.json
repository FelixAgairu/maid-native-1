  "Unlink {0}": "\u0412\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f {0}",
  "Updating as the server reports usage. Some servers only report it when a reply finishes.": "\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f, \u043a\u043e\u043b\u0438 \u0441\u0435\u0440\u0432\u0435\u0440 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u044f\u0454 \u043f\u0440\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f. \u0414\u0435\u044f\u043a\u0456 \u0441\u0435\u0440\u0432\u0435\u0440\u0438 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u044f\u044e\u0442\u044c \u043f\u0440\u043e \u0446\u0435 \u0442\u0456\u043b\u044c\u043a\u0438 \u043f\u0456\u0441\u043b\u044f \u0437\u0430\u043a\u0456\u043d\u0447\u0435\u043d\u043d\u044f \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456.",
  "Usage sums API requests, including tool continuations and repeated input history. Missing or interrupted records remain partial. Deleted replies are excluded; this is not a billing ledger.": "\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0441\u0443\u043c\u0443\u0454 \u0437\u0430\u043f\u0438\u0442\u0438 API, \u0432 \u0442\u043e\u043c\u0443 \u0447\u0438\u0441\u043b\u0456 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0435\u043d\u043d\u044f \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432 \u0456 \u043f\u043e\u0432\u0442\u043e\u0440\u0435\u043d\u043d\u044f \u0456\u0441\u0442\u043e\u0440\u0456\u0457 \u0432\u0432\u043e\u0434\u0443. \u0412\u0456\u0434\u0441\u0443\u0442\u043d\u0456 \u0430\u0431\u043e \u043f\u0435\u0440\u0435\u0440\u0432\u0430\u043d\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0437\u0430\u043b\u0438\u0448\u0430\u044e\u0442\u044c\u0441\u044f \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0438\u043c\u0438. \u0417\u0431\u0438\u0442\u0456 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456 \u0432\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0456; \u0446\u0435 \u043d\u0435 \u0431\u0443\u0445\u0433\u0430\u043b\u0442\u0435\u0440\u0441\u044c\u043a\u0438\u0439 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441.",
  "Use scroll view": "\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0443",
  "User": "\u041a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447",
  "Uses the first message locally; keeps manually chosen titles and uses no extra tokens.": "\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 \u043f\u0435\u0440\u0448\u0435 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e; \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454 \u0440\u0443\u0447\u043d\u043e \u043e\u0431\u0440\u0430\u043d\u0456 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0438 \u0456 \u043d\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0438\u0445 \u0442\u043e\u043a\u0435\u043d\u0456\u0432.",
  "Write access": "\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f",
  "Write file": "\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u0444\u0430\u0439\u043b",
  "Writes": "\u041f\u0438\u0448\u0435",
  "Your name": "\u0422\u0432\u043e\u0454 \u0456\u043c'\u044f",
  "Your profile picture": "\u0412\u0430\u0448\u0430 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0456\u044f \u043f\u0440\u043e\u0444\u0456\u043b\u044e",
  "stopped": "\u0437\u0443\u043f\u0438\u043d\u0435\u043d\u043e",
  "{0} addresses probed": "{0} \u0430\u0434\u0440\u0435\u0441\u0438 \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u043e\u0432\u0430\u043d\u0456",
  "\u2248 is an estimate of the current branch and draft. Tokenization, tool schemas and media can change the actual count.": "\u2248 - \u0446\u0435 \u043e\u0446\u0456\u043d\u043a\u0430 \u043f\u043e\u0442\u043e\u0447\u043d\u043e\u0457 \u0433\u0430\u043b\u0443\u0437\u0456 \u0442\u0430 \u043f\u0440\u043e\u0435\u043a\u0442\u0443. \u0422\u043e\u043a\u0435\u043d\u0456\u0437\u0430\u0446\u0456\u044f, \u0441\u0445\u0435\u043c\u0438 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432 \u0442\u0430 \u0437\u0430\u0441\u043e\u0431\u0438 \u043c\u0430\u0441\u043e\u0432\u043e\u0457 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0457 \u043c\u043e\u0436\u0443\u0442\u044c \u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u0444\u0430\u043a\u0442\u0438\u0447\u043d\u0438\u0439 \u0440\u043e\u0437\u043b\u0456\u043a.",
  "Tools \u00b7 {0}": "\u0406\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438 \u00b7 {0}",
