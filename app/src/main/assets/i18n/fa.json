  "Allow all ({0})": "\u0627\u062c\u0627\u0632\u0647 \u062f\u0627\u062f\u0646 \u0647\u0645\u0647 ({0})",
  "Another server has this name": "\u0633\u0631\u0648\u0631 \u062f\u064a\u06af\u0647 \u0627\u064a \u0627\u064a\u0646 \u0627\u0633\u0645 \u0631\u0648 \u062f\u0627\u0631\u0647",
  "Applies to this conversation, including messages already sent.": "\u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u0627\u06cc\u0646 \u0645\u06a9\u0627\u0644\u0645\u0647\u060c \u0627\u0632 \u062c\u0645\u0644\u0647 \u067e\u06cc\u0627\u0645 \u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0642\u0628\u0644\u0627 \u0627\u0631\u0633\u0627\u0644 \u0634\u062f\u0647 \u0627\u0633\u062a.",
