  "Copy": "\u06a9\u067e\u064a \u0634\u062f\u0647",
  "Cumulative input + output across all retained branches of this conversation, including tool requests. Deleted replies are excluded.": "\u0648\u0631\u0648\u062f\u06cc \u062c\u0645\u0639 \u0622\u0648\u0631\u06cc + \u062e\u0631\u0648\u062c\u06cc \u062f\u0631 \u062a\u0645\u0627\u0645 \u0634\u0627\u062e\u0647 \u0647\u0627\u06cc \u062d\u0641\u0638 \u0634\u062f\u0647 \u0627\u06cc\u0646 \u0645\u06a9\u0627\u0644\u0645\u0647\u060c \u0627\u0632 \u062c\u0645\u0644\u0647 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0647\u0627\u06cc \u0627\u0628\u0632\u0627\u0631. \u067e\u0627\u0633\u062e \u0647\u0627\u06cc \u062d\u0630\u0641 \u0634\u062f\u0647 \u062d\u0630\u0641 \u0645\u06cc \u0634\u0648\u0646\u062f.",
  "Cumulative probability cutoff.": "\u0642\u0637\u0639 \u0627\u062d\u062a\u0645\u0627\u0644\u064a \u062a\u062c\u0645\u064a\u0639\u064a",
  "Current date and time.": "\u062a\u0627\u0631\u06cc\u062e \u0648 \u0632\u0645\u0627\u0646 \u0641\u0639\u0644\u06cc.",
  "Cutoff relative to the top token.": "\u0642\u0637\u0639 \u0646\u0633\u0628\u062a \u0628\u0647 \u062a\u0648\u06a9\u0646 \u0628\u0627\u0644\u0627",
  "Date & time": "\u062a\u0627\u0631\u06cc\u062e \u0648 \u0632\u0645\u0627\u0646",
  "Delete": "\u062d\u0630\u0641",
