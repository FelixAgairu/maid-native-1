  "Hide reasoning": "\u0627\u0633\u062a\u062f\u0644\u0627\u0644 \u067e\u0646\u0647\u0627\u0646",
  "Hide tool calls": "\u062a\u0645\u0627\u0633 \u0647\u0627\u06cc \u0627\u0628\u0632\u0627\u0631 \u0631\u0627 \u067e\u0646\u0647\u0627\u0646 \u06a9\u0646\u06cc\u062f",
  "Hide tool result": "\u0646\u062a\u06cc\u062c\u0647 \u0627\u0628\u0632\u0627\u0631 \u067e\u0646\u0647\u0627\u0646 \u06a9\u0631\u062f\u0646",
