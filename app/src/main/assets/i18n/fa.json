  "Show tool calls": "\u062a\u0645\u0627\u0633 \u0647\u0627\u06cc \u0627\u0628\u0632\u0627\u0631 \u0631\u0627 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0647\u06cc\u062f",
  "Show tool result": "\u0646\u062a\u0627\u06cc\u062c \u0627\u0628\u0632\u0627\u0631 \u0631\u0627 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0647\u06cc\u062f",
  "Subnet": "\u0632\u06cc\u0631\u0634\u0628\u06a9\u0647",
  "System": "\u0633\u06cc\u0633\u062a\u0645",
  "System default": "\u0633\u06cc\u0633\u062a\u0645 \u067e\u06cc\u0634 \u0641\u0631\u0636",
  "System prompt": "\u0633\u0631\u06cc\u0639 \u0633\u06cc\u0633\u062a\u0645",
  "Tags": "\u0628\u0631\u0686\u0633\u0628 \u0647\u0627",
  "Temperature": "\u062f\u0631\u062c\u0647 \u062d\u0631\u0627\u0631\u062a",
  "Text file": "\u0641\u0627\u06cc\u0644 \u0645\u062a\u0646\u06cc",
  "The conversation has grown since it was last counted; the next reply will update it.": "\u0627\u06cc\u0646 \u0645\u06a9\u0627\u0644\u0645\u0647 \u0627\u0632 \u0632\u0645\u0627\u0646 \u0622\u062e\u0631\u06cc\u0646 \u0634\u0645\u0627\u0631\u0634 \u0631\u0634\u062f \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a\u061b \u067e\u0627\u0633\u062e \u0628\u0639\u062f\u06cc \u0622\u0646 \u0631\u0627 \u0628\u0647 \u0631\u0648\u0632 \u062e\u0648\u0627\u0647\u062f \u06a9\u0631\u062f.",
  "The conversation has shrunk since it was last counted; the next reply will update it.": "\u0627\u06cc\u0646 \u0645\u06a9\u0627\u0644\u0645\u0647 \u0627\u0632 \u0622\u062e\u0631\u06cc\u0646 \u0628\u0627\u0631 \u06a9\u0647 \u0634\u0645\u0627\u0631\u0634 \u0634\u062f \u06a9\u0645 \u0634\u062f\u0647 \u0627\u0633\u062a\u061b \u067e\u0627\u0633\u062e \u0628\u0639\u062f\u06cc \u0622\u0646 \u0631\u0627 \u0628\u0647 \u0631\u0648\u0632 \u062e\u0648\u0627\u0647\u062f \u06a9\u0631\u062f.",
  "The local subnet is probed on this port for an OpenAI-compatible endpoint.": "\u0634\u0628\u06a9\u0647 \u0641\u0631\u0639\u06cc \u0645\u062d\u0644\u06cc \u062f\u0631 \u0627\u06cc\u0646 \u0628\u0646\u062f\u0631 \u0628\u0631\u0627\u06cc \u06cc\u06a9 \u0646\u0642\u0637\u0647 \u067e\u0627\u06cc\u0627\u0646\u06cc \u0633\u0627\u0632\u06af\u0627\u0631 \u0628\u0627 OpenAI \u0628\u0631\u0631\u0633\u06cc \u0645\u06cc \u0634\u0648\u062f.",
  "The saved token can't be decrypted. Enter it again.": "\u0646\u0645\u064a\u062a\u0648\u0646\u0647 \u0631\u0645\u0632\u06af\u0634\u0627\u06cc\u06cc \u0634\u062f\u0647 \u0628\u0627\u0634\u0647 \u062f\u0648\u0628\u0627\u0631\u0647 \u0648\u0627\u0631\u062f\u0634 \u06a9\u0646",
  "The server did not report a context capacity.": "\u0633\u0631\u0648\u0631 \u06cc\u06a9 \u0638\u0631\u0641\u06cc\u062a \u0632\u0645\u06cc\u0646\u0647 \u0631\u0627 \u06af\u0632\u0627\u0631\u0634 \u0646\u06a9\u0631\u062f.",
  "The server lists no tools.": "\u0633\u0631\u0648\u0631 \u0647\u064a\u0686 \u0627\u0628\u0632\u0627\u0631\u064a \u0631\u0648 \u0641\u0647\u0631\u0633\u062a \u0646\u0645\u064a\u06a9\u0646\u0647",
  "The stored API key can no longer be decrypted on this device. Enter it again to replace it.": "\u06a9\u0644\u06cc\u062f API \u0630\u062e\u06cc\u0631\u0647 \u0634\u062f\u0647 \u062f\u06cc\u06af\u0631 \u0646\u0645\u06cc \u062a\u0648\u0627\u0646\u062f \u062f\u0631 \u0627\u06cc\u0646 \u062f\u0633\u062a\u06af\u0627\u0647 \u0631\u0645\u0632\u06af\u0630\u0627\u0631\u06cc \u0634\u0648\u062f. \u062f\u0648\u0628\u0627\u0631\u0647 \u0622\u0646 \u0631\u0627 \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f \u062a\u0627 \u0622\u0646 \u0631\u0627 \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646 \u06a9\u0646\u06cc\u062f.",
  "Theme": "\u0645\u0648\u0636\u0648\u0639",
  "Thinking": "\u0641\u06a9\u0631 \u06a9\u0631\u062f\u0646",
  "This file is no longer available.": "\u0627\u06cc\u0646 \u0641\u0627\u06cc\u0644 \u062f\u06cc\u06af\u0631 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0646\u06cc\u0633\u062a.",
  "Time to first token": "\u0648\u0642\u062a\u0634\u0647 \u06a9\u0647 \u0627\u0648\u0644\u064a\u0646 \u0646\u0645\u0631\u0647",
  "Token can't be decrypted \u2014 enter it again": "\u0646\u0645\u0627\u062f \u0646\u0645\u064a\u062a\u0648\u0646\u0647 \u0631\u0645\u0632\u06af\u0634\u0627\u06cc\u06cc \u0628\u0634\u0647 \u062f\u0648\u0628\u0627\u0631\u0647 \u0648\u0627\u0631\u062f\u0634 \u06a9\u0646",
  "Token usage pending": "\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062a\u0648\u06a9\u0646 \u062f\u0631 \u0627\u0646\u062a\u0638\u0627\u0631",
  "Token usage unavailable": "\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062a\u0648\u06a9\u0646 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0646\u06cc\u0633\u062a",
  "Token usage \u00b7 active branch": "\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062a\u0648\u06a9\u0646 \u00b7 \u0634\u0627\u062e\u0647 \u0641\u0639\u0627\u0644",
  "Token usage \u00b7 saved history": "\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062a\u0648\u06a9\u0646 \u0647\u0627 \u00b7 \u062a\u0627\u0631\u06cc\u062e\u0686\u0647 \u0630\u062e\u06cc\u0631\u0647 \u0634\u062f\u0647",
  "Tool calls \u00b7 {0}": "\u062a\u0645\u0627\u0633 \u0628\u0627 \u0627\u0628\u0632\u0627\u0631 \u00b7 {0}",
  "Tools": "\u0627\u0628\u0632\u0627\u0631",
  "Tools are prefixed with {0}__": "\u0627\u0628\u0632\u0627\u0631\u0647\u0627 \u0628\u0627 {0}__",
