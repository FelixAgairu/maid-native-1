  "Trust user-installed certificates": "\u06af\u0648\u0627\u0647\u06cc\u0646\u0627\u0645\u0647 \u0647\u0627\u06cc \u0646\u0635\u0628 \u0634\u062f\u0647 \u062a\u0648\u0633\u0637 \u06a9\u0627\u0631\u0628\u0631 \u0627\u0639\u062a\u0645\u0627\u062f",
  "Twilight": "\u0634\u0628 \u0642\u062f\u0631",
  "Unencrypted HTTP. Only enable on trusted networks. Local servers may need this.": "HTTP \u063a\u06cc\u0631 \u0631\u0645\u0632\u06af\u0630\u0627\u0631\u06cc \u0634\u062f\u0647. \u0641\u0642\u0637 \u062f\u0631 \u0634\u0628\u06a9\u0647 \u0647\u0627\u06cc \u0642\u0627\u0628\u0644 \u0627\u0639\u062a\u0645\u0627\u062f \u0641\u0639\u0627\u0644 \u06a9\u0646\u06cc\u062f. \u0633\u0631\u0648\u0631\u0647\u0627\u06cc \u0645\u062d\u0644\u06cc \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0628\u0647 \u0627\u06cc\u0646 \u0646\u06cc\u0627\u0632 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u0646\u062f.",
  "Unencrypted: trusted networks only": "\u0631\u0645\u0632\u06af\u0630\u0627\u0631\u06cc \u0646\u0634\u062f\u0647: \u062a\u0646\u0647\u0627 \u0634\u0628\u06a9\u0647 \u0647\u0627\u06cc \u0642\u0627\u0628\u0644 \u0627\u0639\u062a\u0645\u0627\u062f",
  "Unlink {0}": "{0} \u062c\u062f\u0627 \u06a9\u0631\u062f\u0646 \u0644\u06cc\u0646\u06a9",
  "Updating as the server reports usage. Some servers only report it when a reply finishes.": "\u0628\u0647 \u0631\u0648\u0632 \u0631\u0633\u0627\u0646\u06cc \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0633\u0631\u0648\u0631 \u06af\u0632\u0627\u0631\u0634 \u0627\u0633\u062a\u0641\u0627\u062f\u0647. \u0628\u0631\u062e\u06cc \u0627\u0632 \u0633\u0631\u0648\u0631\u0647\u0627 \u0622\u0646 \u0631\u0627 \u062a\u0646\u0647\u0627 \u0632\u0645\u0627\u0646\u06cc \u06af\u0632\u0627\u0631\u0634 \u0645\u06cc \u06a9\u0646\u0646\u062f \u06a9\u0647 \u067e\u0627\u0633\u062e \u0628\u0647 \u067e\u0627\u06cc\u0627\u0646 \u0645\u06cc \u0631\u0633\u062f.",
  "Usage sums API requests, including tool continuations and repeated input history. Missing or interrupted records remain partial. Deleted replies are excluded; this is not a billing ledger.": "\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0647\u0627\u06cc API\u060c \u0627\u0632 \u062c\u0645\u0644\u0647 \u0627\u062f\u0627\u0645\u0647 \u0627\u0628\u0632\u0627\u0631 \u0648 \u062a\u0627\u0631\u06cc\u062e\u0686\u0647 \u0648\u0631\u0648\u062f\u06cc \u0645\u06a9\u0631\u0631 \u0631\u0627 \u062c\u0645\u0639 \u0645\u06cc \u06a9\u0646\u062f. \u0633\u0648\u0627\u0628\u0642 \u06af\u0645\u0634\u062f\u0647 \u06cc\u0627 \u0642\u0637\u0639 \u0634\u062f\u0647 \u062c\u0632\u0648\u06cc \u0628\u0627\u0642\u06cc \u0645\u06cc \u0645\u0627\u0646\u0646\u062f. \u067e\u0627\u0633\u062e \u0647\u0627\u06cc \u062d\u0630\u0641 \u0634\u062f\u0647 \u062d\u0630\u0641 \u0645\u06cc \u0634\u0648\u0646\u062f\u061b \u0627\u06cc\u0646 \u06cc\u06a9 \u062f\u0641\u062a\u0631 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0646\u06cc\u0633\u062a.",
  "Use scroll view": "\u0627\u0632 \u0631\u0648\u06cc scroll \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f",
  "User": "\u06a9\u0627\u0631\u0628\u0631",
  "Uses the first message locally; keeps manually chosen titles and uses no extra tokens.": "\u0627\u0632 \u067e\u06cc\u0627\u0645 \u0627\u0648\u0644 \u0645\u062d\u0644\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc \u06a9\u0646\u062f\u061b \u0639\u0646\u0627\u0648\u06cc\u0646 \u062f\u0633\u062a\u06cc \u0631\u0627 \u062d\u0641\u0638 \u0645\u06cc \u06a9\u0646\u062f \u0648 \u0627\u0632 \u062a\u0648\u06a9\u0646 \u0647\u0627\u06cc \u0627\u0636\u0627\u0641\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u0645\u06cc \u06a9\u0646\u062f.",
