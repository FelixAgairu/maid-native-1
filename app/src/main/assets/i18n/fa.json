  "No API key": "\u0647\u06cc\u0686 \u06a9\u0644\u06cc\u062f API \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f",
  "No chats yet": "\u0647\u0646\u0648\u0632 \u0686\u062a \u0646\u06a9\u0631\u062f\u0645",
  "No matching models": "\u0647\u06cc\u0686 \u0645\u062f\u0644 \u0645\u0634\u0627\u0628\u0647\u06cc \u0646\u06cc\u0633\u062a",
  "No models loaded. Tap the scan button or refresh to fetch /models.": "\u0647\u06cc\u0686 \u0645\u062f\u0644 \u0627\u06cc \u0634\u0627\u0631\u0698 \u0646\u0634\u062f\u0647\u060c \u062f\u06a9\u0645\u0647 \u0627\u0633\u06a9\u0646 \u0631\u0627 \u0628\u0632\u0646\u06cc\u062f \u06cc\u0627 \u062a\u0627\u0632\u0647 \u06a9\u0646\u06cc\u062f \u062a\u0627 \u0645\u062f\u0644 \u0647\u0627 \u0631\u0627 \u0628\u06af\u06cc\u0631\u06cc\u062f.",
  "None": "\u0647\u06cc\u0686\u06a9\u0633",
  "Nothing saved yet. A preset keeps a Base URL and its API key together, so switching endpoints takes one tap.": "\u0647\u0646\u0648\u0632 \u0686\u06cc\u0632\u06cc \u0630\u062e\u06cc\u0631\u0647 \u0646\u0634\u062f\u0647 \u0627\u0633\u062a. \u06cc\u06a9 \u067e\u06cc\u0634 \u062a\u0646\u0638\u06cc\u0645 \u06cc\u06a9 URL \u067e\u0627\u06cc\u0647 \u0648 \u06a9\u0644\u06cc\u062f API \u0631\u0627 \u0628\u0627 \u0647\u0645 \u0646\u06af\u0647 \u0645\u06cc \u062f\u0627\u0631\u062f\u060c \u0628\u0646\u0627\u0628\u0631\u0627\u06cc\u0646 \u062a\u063a\u06cc\u06cc\u0631 \u0646\u0642\u0627\u0637 \u067e\u0627\u06cc\u0627\u0646 \u06cc\u06a9 \u0636\u0631\u0628\u0647 \u0627\u0633\u062a.",
  "Nudges toward new topics.": "\u0628\u0647 \u0633\u0645\u062a \u0645\u0648\u0636\u0648\u0639\u0627\u062a \u062c\u062f\u06cc\u062f \u062d\u0631\u06a9\u062a \u0645\u06cc \u06a9\u0646\u062f",
  "Off": "\u062e\u0627\u0645\u0648\u0634 \u0634\u0648",
  "Off: system certificates only. On: system and user-installed CA certificates for API and MCP connections. Hostname and certificate checks remain enabled. Restart the app after installing or removing a CA.": "\u062e\u0627\u0645\u0648\u0634: \u0641\u0642\u0637 \u06af\u0648\u0627\u0647\u06cc\u0646\u0627\u0645\u0647 \u0647\u0627\u06cc \u0633\u06cc\u0633\u062a\u0645. \u0641\u0639\u0627\u0644: \u06af\u0648\u0627\u0647\u06cc\u0646\u0627\u0645\u0647 CA \u0633\u06cc\u0633\u062a\u0645 \u0648 \u0646\u0635\u0628 \u0634\u062f\u0647 \u062a\u0648\u0633\u0637 \u06a9\u0627\u0631\u0628\u0631 \u0628\u0631\u0627\u06cc \u0627\u062a\u0635\u0627\u0644 API \u0648 MCP. \u0628\u0631\u0631\u0633\u06cc \u0646\u0627\u0645 \u0645\u06cc\u0632\u0628\u0627\u0646 \u0648 \u06af\u0648\u0627\u0647\u06cc\u0646\u0627\u0645\u0647 \u0647\u0645\u0686\u0646\u0627\u0646 \u0641\u0639\u0627\u0644 \u0627\u0633\u062a. \u0628\u0631\u0646\u0627\u0645\u0647 \u0631\u0627 \u067e\u0633 \u0627\u0632 \u0646\u0635\u0628 \u06cc\u0627 \u062d\u0630\u0641 \u06cc\u06a9 CA \u062f\u0648\u0628\u0627\u0631\u0647 \u0631\u0627\u0647 \u0627\u0646\u062f\u0627\u0632\u06cc \u06a9\u0646\u06cc\u062f.",
  "Older tool replies may only include the final request's usage.": "\u067e\u0627\u0633\u062e \u0647\u0627\u06cc \u0642\u062f\u06cc\u0645\u06cc \u062a\u0631 \u0645\u06cc \u062a\u0648\u0627\u0646\u0646\u062f \u0641\u0642\u0637 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0646\u0647\u0627\u06cc\u06cc \u0631\u0627 \u0634\u0627\u0645\u0644 \u06a9\u0646\u0646\u062f.",
  "Output tokens": "\u062a\u0648\u06a9\u0646 \u0647\u0627\u06cc \u062e\u0631\u0648\u062c\u06cc",
  "Partial: totals include only known counts. Some requests are unfinished or have missing usage.": "\u062c\u0632\u0648\u06cc: \u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0634\u0627\u0645\u0644 \u062a\u0639\u062f\u0627\u062f \u0634\u0646\u0627\u062e\u062a\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a. \u0628\u0631\u062e\u06cc \u0627\u0632 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0647\u0627 \u062a\u06a9\u0645\u06cc\u0644 \u0646\u0634\u062f\u0647 \u06cc\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0622\u0646\u0647\u0627 \u0631\u0627 \u0627\u0632 \u062f\u0633\u062a \u062f\u0627\u062f\u0647 \u0627\u0646\u062f.",
