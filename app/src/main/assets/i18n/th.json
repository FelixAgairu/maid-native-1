  "Edit MCP server": "\u0e1b\u0e23\u0e31\u0e1a\u0e1b\u0e23\u0e38\u0e07 MCP Server",
  "Edit file": "\u0e41\u0e01\u0e49\u0e44\u0e02\u0e44\u0e1f\u0e25\u0e4c",
  "Edit message": "\u0e1b\u0e23\u0e31\u0e1a\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21",
  "Edit system prompt": "\u0e1b\u0e23\u0e31\u0e1a\u0e23\u0e30\u0e1a\u0e1a prompt",
  "Endpoint": "\u0e08\u0e38\u0e14\u0e1b\u0e25\u0e32\u0e22",
  "Endpoint found": "\u0e08\u0e38\u0e14\u0e1b\u0e25\u0e32\u0e22\u0e17\u0e35\u0e48\u0e1e\u0e1a",
  "Enter a port between 1 and 65535": "\u0e43\u0e2a\u0e48\u0e17\u0e48\u0e32\u0e23\u0e30\u0e2b\u0e27\u0e48\u0e32\u0e07 1 \u0e41\u0e25\u0e30 65535",
  "Enter an http or https URL": "\u0e01\u0e23\u0e2d\u0e01 URL http \u0e2b\u0e23\u0e37\u0e2d https",
  "Expand all": "\u0e02\u0e22\u0e32\u0e22\u0e17\u0e31\u0e49\u0e07\u0e2b\u0e21\u0e14",
  "Export": "\u0e01\u0e32\u0e23\u0e2a\u0e48\u0e07\u0e2d\u0e2d\u0e01",
  "Export all": "\u0e2a\u0e48\u0e07\u0e2d\u0e2d\u0e01\u0e17\u0e31\u0e49\u0e07\u0e2b\u0e21\u0e14",
  "Export media": "\u0e2a\u0e37\u0e48\u0e2d\u0e01\u0e32\u0e23\u0e2a\u0e48\u0e07\u0e2d\u0e2d\u0e01",
  "Fades out while you type. Images are cropped to the pill and copied into the app.": "\u0e2b\u0e32\u0e22\u0e44\u0e1b\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e04\u0e38\u0e13\u0e40\u0e02\u0e35\u0e22\u0e19\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e\u0e16\u0e39\u0e01\u0e15\u0e31\u0e14\u0e44\u0e1b\u0e01\u0e31\u0e1a\u0e22\u0e32 \u0e41\u0e25\u0e30\u0e40\u0e25\u0e35\u0e22\u0e19\u0e44\u0e1b\u0e43\u0e19\u0e41\u0e2d\u0e1e",
  "Fetch URL": "\u0e19\u0e4d\u0e32 URL",
  "Files": "\u0e44\u0e1f\u0e25\u0e4c",
  "Find text in a file linked to the chat.": "\u0e04\u0e49\u0e19\u0e2b\u0e32\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e43\u0e19\u0e44\u0e1f\u0e25\u0e4c\u0e17\u0e35\u0e48\u0e40\u0e01\u0e35\u0e48\u0e22\u0e27\u0e02\u0e49\u0e2d\u0e07\u0e01\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e41\u0e0a\u0e17",
  "Frequency penalty": "\u0e1b\u0e23\u0e31\u0e1a\u0e04\u0e27\u0e32\u0e21\u0e16\u0e35\u0e48",
  "Hide reasoning": "\u0e1b\u0e34\u0e14\u0e04\u0e27\u0e32\u0e21\u0e04\u0e34\u0e14",
  "Hide tool calls": "\u0e1b\u0e34\u0e14\u0e01\u0e32\u0e23\u0e40\u0e23\u0e35\u0e22\u0e01\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e21\u0e37\u0e2d",
  "Hide tool result": "\u0e1b\u0e34\u0e14\u0e1c\u0e25\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e21\u0e37\u0e2d",
  "Higher is more random.": "\u0e17\u0e35\u0e48\u0e2a\u0e39\u0e07\u0e01\u0e27\u0e48\u0e32\u0e19\u0e31\u0e49\u0e19 \u0e40\u0e1b\u0e47\u0e19\u0e40\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e2a\u0e38\u0e48\u0e21\u0e21\u0e32\u0e01\u0e01\u0e27\u0e48\u0e32",
  "Image": "\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e",
  "Import": "\u0e01\u0e32\u0e23\u0e19\u0e4d\u0e32\u0e40\u0e02\u0e49\u0e32",
  "In use": "\u0e43\u0e0a\u0e49\u0e07\u0e32\u0e19",
  "In {0} \u00b7 Out {1}": "\u0e43\u0e19 {0} \u00b7 \u0e2d\u0e2d\u0e01 {1}",
  "In {0} \u00b7 Out {1} \u00b7 {2} {3} tokens": "\u0e43\u0e19 {0} \u00b7 \u0e2d\u0e2d\u0e01 {1} \u00b7 {2} {3} \u0e17\u0e34\u0e4a\u0e01\u0e40\u0e01\u0e19",
  "Includes attached images and audio in exported conversations.": "\u0e1b\u0e23\u0e30\u0e01\u0e2d\u0e1a\u0e14\u0e49\u0e27\u0e22\u0e20\u0e32\u0e1e\u0e41\u0e25\u0e30\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e17\u0e35\u0e48\u0e15\u0e34\u0e14\u0e15\u0e48\u0e2d\u0e43\u0e19\u0e1a\u0e17\u0e2a\u0e19\u0e17\u0e19\u0e32\u0e2a\u0e48\u0e07\u0e2d\u0e2d\u0e01",
  "Input includes history sent again on each request. This is usage, not the number of tokens currently in the model's context window.": "\u0e01\u0e32\u0e23\u0e40\u0e02\u0e49\u0e32\u0e23\u0e27\u0e21\u0e1b\u0e23\u0e30\u0e27\u0e31\u0e15\u0e34\u0e28\u0e32\u0e2a\u0e15\u0e23\u0e4c\u0e17\u0e35\u0e48\u0e2a\u0e48\u0e07\u0e2d\u0e35\u0e01\u0e04\u0e23\u0e31\u0e49\u0e07\u0e01\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e02\u0e2d\u0e41\u0e15\u0e48\u0e25\u0e30\u0e04\u0e23\u0e31\u0e49\u0e07 \u0e19\u0e35\u0e48\u0e04\u0e37\u0e2d\u0e01\u0e32\u0e23\u0e43\u0e0a\u0e49\u0e07\u0e32\u0e19 \u0e44\u0e21\u0e48\u0e43\u0e0a\u0e48\u0e08\u0e4d\u0e32\u0e19\u0e27\u0e19\u0e17\u0e47\u0e2d\u0e04\u0e2d\u0e19\u0e43\u0e19\u0e02\u0e13\u0e30\u0e19\u0e35\u0e49\u0e43\u0e19\u0e2b\u0e19\u0e49\u0e32\u0e15\u0e48\u0e32\u0e07\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e32\u0e02\u0e2d\u0e07\u0e42\u0e21\u0e40\u0e14\u0e25",
  "Input tokens": "\u0e2a\u0e31\u0e0d\u0e25\u0e31\u0e01\u0e29\u0e13\u0e4c\u0e01\u0e32\u0e23\u0e40\u0e02\u0e49\u0e32",
  "JavaScript": "JavaScript",
  "Key can't be decrypted \u2014 re-save": "\u0e40\u0e04\u0e25\u0e47\u0e14\u0e25\u0e31\u0e1a\u0e44\u0e21\u0e48\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e2d\u0e2d\u0e01\u0e23\u0e2b\u0e31\u0e2a\u0e44\u0e14\u0e49",
  "Known total": "\u0e08\u0e4d\u0e32\u0e19\u0e27\u0e19\u0e17\u0e31\u0e49\u0e07\u0e2b\u0e21\u0e14\u0e17\u0e35\u0e48\u0e17\u0e23\u0e32\u0e1a",
  "Known total (partial)": "\u0e08\u0e4d\u0e32\u0e19\u0e27\u0e19\u0e17\u0e31\u0e49\u0e07\u0e2b\u0e21\u0e14 (\u0e1a\u0e32\u0e07\u0e2a\u0e48\u0e27\u0e19)",
  "Language": "\u0e20\u0e32\u0e29\u0e32",
  "Link file": "\u0e23\u0e2b\u0e31\u0e2a\u0e44\u0e1f\u0e25\u0e4c",
  "Link files to a chat.": "\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e44\u0e1f\u0e25\u0e4c\u0e44\u0e1b\u0e22\u0e31\u0e07\u0e0a\u0e47\u0e2d\u0e15",
  "Linked files": "\u0e44\u0e1f\u0e25\u0e4c\u0e17\u0e35\u0e48\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e15\u0e48\u0e2d",
  "List": "\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23",
  "Local": "\u0e2a\u0e16\u0e32\u0e19\u0e17\u0e35\u0e48",
  "Long messages and reasoning scroll inside their cards. Expand any card to read it in full.": "\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e22\u0e32\u0e27\u0e46 \u0e41\u0e25\u0e30\u0e01\u0e32\u0e23\u0e2a\u0e23\u0e23\u0e1e\u0e23\u0e23\u0e13\u0e04\u0e27\u0e32\u0e21\u0e04\u0e34\u0e14 \u0e2d\u0e22\u0e39\u0e48\u0e43\u0e19\u0e1a\u0e31\u0e15\u0e23\u0e02\u0e2d\u0e07\u0e1e\u0e27\u0e01\u0e40\u0e02\u0e32",
  "Media token costs are not included in the estimate.": "\u0e23\u0e32\u0e04\u0e32\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e2b\u0e21\u0e32\u0e22\u0e2a\u0e37\u0e48\u0e2d\u0e44\u0e21\u0e48\u0e44\u0e14\u0e49\u0e23\u0e27\u0e21\u0e2d\u0e22\u0e39\u0e48\u0e43\u0e19\u0e1b\u0e23\u0e30\u0e21\u0e32\u0e13\u0e01\u0e32\u0e23",
  "Message": "\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21",
  "Min P": "Min P",
  "Model": "\u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07",
  "Modify": "\u0e1b\u0e23\u0e31\u0e1a\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19",
  "More chat actions": "\u0e01\u0e34\u0e08\u0e01\u0e23\u0e23\u0e21\u0e43\u0e19\u0e01\u0e32\u0e23\u0e41\u0e0a\u0e17\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e40\u0e15\u0e34\u0e21",
  "Must be a JSON object": "\u0e15\u0e49\u0e2d\u0e07\u0e40\u0e1b\u0e47\u0e19\u0e02\u0e2d\u0e07 JSON",
  "Name": "\u0e0a\u0e37\u0e48\u0e2d",
  "Network": "\u0e40\u0e04\u0e23\u0e37\u0e2d\u0e02\u0e48\u0e32\u0e22",
  "New chat": "\u0e41\u0e0a\u0e17\u0e43\u0e2b\u0e21\u0e48",
  "New file": "\u0e44\u0e1f\u0e25\u0e4c\u0e43\u0e2b\u0e21\u0e48",
  "Next branch": "\u0e2a\u0e32\u0e02\u0e32\u0e15\u0e48\u0e2d\u0e44\u0e1b",
  "No API key": "\u0e44\u0e21\u0e48\u0e21\u0e35\u0e01\u0e38\u0e0d\u0e41\u0e08 API",
  "No chats yet": "\u0e22\u0e31\u0e07\u0e44\u0e21\u0e48\u0e21\u0e35\u0e01\u0e32\u0e23\u0e04\u0e38\u0e22\u0e01\u0e31\u0e19",
  "No matching models": "\u0e44\u0e21\u0e48\u0e21\u0e35\u0e23\u0e38\u0e48\u0e19\u0e17\u0e35\u0e48\u0e15\u0e23\u0e07\u0e01\u0e31\u0e19",
  "No models loaded. Tap the scan button or refresh to fetch /models.": "\u0e44\u0e21\u0e48\u0e21\u0e35\u0e23\u0e38\u0e48\u0e19\u0e17\u0e35\u0e48\u0e42\u0e2b\u0e25\u0e14 \u0e01\u0e14\u0e1b\u0e38\u0e48\u0e21\u0e2a\u0e41\u0e01\u0e19 \u0e2b\u0e23\u0e37\u0e2d\u0e2d\u0e31\u0e1e\u0e40\u0e14\u0e17\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e2b\u0e32\u0e23\u0e38\u0e48\u0e19",
  "None": "\u0e44\u0e21\u0e48\u0e21\u0e35\u0e43\u0e04\u0e23",
  "Nothing saved yet. A preset keeps a Base URL and its API key together, so switching endpoints takes one tap.": "\u0e44\u0e21\u0e48\u0e21\u0e35\u0e2d\u0e30\u0e44\u0e23\u0e17\u0e35\u0e48\u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01\u0e44\u0e27\u0e49\u0e22\u0e31\u0e07\u0e04\u0e23\u0e31\u0e1a \u0e01\u0e32\u0e23\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e25\u0e48\u0e27\u0e07\u0e2b\u0e19\u0e49\u0e32\u0e08\u0e30\u0e40\u0e01\u0e47\u0e1a URL \u0e41\u0e1a\u0e2a \u0e41\u0e25\u0e30\u0e1b\u0e38\u0e48\u0e21 API \u0e02\u0e2d\u0e07\u0e21\u0e31\u0e19\u0e44\u0e27\u0e49\u0e14\u0e49\u0e27\u0e22\u0e01\u0e31\u0e19 \u0e14\u0e31\u0e07\u0e19\u0e31\u0e49\u0e19\u0e01\u0e32\u0e23\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e1b\u0e25\u0e32\u0e22\u0e08\u0e38\u0e14\u0e43\u0e0a\u0e49\u0e40\u0e27\u0e25\u0e32\u0e40\u0e1e\u0e35\u0e22\u0e07\u0e41\u0e15\u0e30\u0e40\u0e14\u0e35\u0e22\u0e27",
  "Nudges toward new topics.": "\u0e2a\u0e19\u0e38\u0e01\u0e44\u0e1b\u0e2a\u0e39\u0e48\u0e2b\u0e31\u0e27\u0e02\u0e49\u0e2d\u0e43\u0e2b\u0e21\u0e48\u0e46",
  "Off": "\u0e2d\u0e2d\u0e01\u0e44\u0e1b",
  "Off: system certificates only. On: system and user-installed CA certificates for API and MCP connections. Hostname and certificate checks remain enabled. Restart the app after installing or removing a CA.": "\u0e1b\u0e34\u0e14: \u0e40\u0e2d\u0e01\u0e2a\u0e32\u0e23\u0e23\u0e30\u0e1a\u0e1a\u0e40\u0e17\u0e48\u0e32\u0e19\u0e31\u0e49\u0e19 \u0e40\u0e1b\u0e34\u0e14: \u0e23\u0e30\u0e1a\u0e1a \u0e41\u0e25\u0e30 \u0e40\u0e2d\u0e01\u0e2a\u0e32\u0e23 CA \u0e17\u0e35\u0e48\u0e15\u0e34\u0e14\u0e15\u0e31\u0e49\u0e07\u0e42\u0e14\u0e22\u0e1c\u0e39\u0e49\u0e43\u0e0a\u0e49\u0e2a\u0e4d\u0e32\u0e2b\u0e23\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e15\u0e48\u0e2d API \u0e41\u0e25\u0e30 MCP \u0e01\u0e32\u0e23\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a\u0e0a\u0e37\u0e48\u0e2d\u0e40\u0e08\u0e49\u0e32\u0e20\u0e32\u0e1e\u0e41\u0e25\u0e30 \u0e40\u0e2d\u0e01\u0e2a\u0e32\u0e23\u0e22\u0e31\u0e07\u0e04\u0e07\u0e40\u0e1b\u0e34\u0e14\u0e43\u0e2b\u0e49\u0e43\u0e0a\u0e49\u0e07\u0e32\u0e19 \u0e01\u0e25\u0e31\u0e1a\u0e21\u0e32\u0e40\u0e1b\u0e34\u0e14\u0e41\u0e2d\u0e1e\u0e2b\u0e25\u0e31\u0e07\u0e08\u0e32\u0e01\u0e15\u0e34\u0e14\u0e15\u0e31\u0e49\u0e07\u0e2b\u0e23\u0e37\u0e2d\u0e16\u0e2d\u0e14 CA",
  "Older tool replies may only include the final request's usage.": "\u0e04\u0e4d\u0e32\u0e15\u0e2d\u0e1a\u0e02\u0e2d\u0e07\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e21\u0e37\u0e2d\u0e40\u0e01\u0e48\u0e32\u0e2d\u0e32\u0e08\u0e23\u0e27\u0e21\u0e16\u0e36\u0e07\u0e01\u0e32\u0e23\u0e43\u0e0a\u0e49\u0e04\u0e4d\u0e32\u0e02\u0e2d\u0e2a\u0e38\u0e14\u0e17\u0e49\u0e32\u0e22\u0e40\u0e17\u0e48\u0e32\u0e19\u0e31\u0e49\u0e19",
  "Output tokens": "\u0e2a\u0e31\u0e0d\u0e25\u0e31\u0e01\u0e29\u0e13\u0e4c\u0e01\u0e32\u0e23\u0e2d\u0e2d\u0e01",
