  "Rolls like 2d6 or 1d20+5.": "2d6 \u0dc4\u0ddd 1d20+5 \u0dc0\u0d9c\u0dda \u0dbb\u0ddd\u0dbd\u0dca\u0dc3\u0dca.",
  "Run tools without asking.": "\u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0d87\u0dc4\u0dd4\u0dc0\u0dd9 \u0db1\u0dd0\u0dad\u0dd4\u0dc0\u0db8 \u0daf\u0dd4\u0dc0\u0db1\u0dca\u0db1.",
  "Running\u2026": "\u0daf\u0dd4\u0dc0\u0db1\u0dc0\u0dcf...",
