  "Rename preset": "\u0db1\u0dcf\u0db8\u0dba \u0dc0\u0dd9\u0db1\u0dc3\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda \u0db4\u0dd9\u0dbb\u0db1\u0dd2\u0db8\u0dcf\u0dc0",
  "Replace or append to a file linked to the chat.": "\u0da0\u0dd0\u0da7\u0dca \u0d91\u0d9a\u0da7 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0dc6\u0dba\u0dd2\u0dbd\u0dca \u0d91\u0d9a\u0d9a\u0dca \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1.",
