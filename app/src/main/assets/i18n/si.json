  "Delete message": "\u0db4\u0dab\u0dd2\u0dc0\u0dd2\u0da9\u0dba \u0db8\u0d9a\u0dcf \u0daf\u0dd0\u0db8\u0dd3\u0db8",
  "Delete preset": "\u0db4\u0dd9\u0dbb \u0dc3\u0dd0\u0d9a\u0dc3\u0dd4\u0db8 \u0db8\u0d9a\u0dcf \u0daf\u0dd0\u0db8\u0dd3\u0db8",
  "Delete server": "\u0dc3\u0dda\u0dc0\u0dcf\u0daf\u0dcf\u0dba\u0d9a\u0dba \u0db8\u0d9a\u0dcf \u0daf\u0db8\u0db1\u0dca\u0db1",
  "Delete this conversation permanently? This can't be undone.": "\u0db8\u0dda \u0dc3\u0d82\u0dc0\u0dcf\u0daf\u0dba \u0dc3\u0dca\u0dae\u0dd2\u0dbb\u0dc0\u0db8 \u0db8\u0d9a\u0dcf \u0daf\u0db8\u0db1\u0dca\u0db1?",
