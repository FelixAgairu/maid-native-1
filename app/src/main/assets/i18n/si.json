  "Context \u00b7 {0} tokens": "\u0dc3\u0db1\u0dca\u0daf\u0dbb\u0dca\u0db7\u0dba \u00b7 {0} \u0da7\u0ddd\u0d9a\u0db1",
  "Conversation size": "\u0dc3\u0d82\u0dc0\u0dcf\u0daf\u0dba\u0dda \u0db4\u0dca \u0dbb\u0db8\u0dcf\u0dab\u0dba",
  "Conversation token usage": "\u0dc3\u0d82\u0dc0\u0dcf\u0daf \u0dc3\u0d82\u0d9a\u0dda\u0dad \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dba",
  "Conversation token usage: {0} tokens{1}. Input {2}, output {3}. View details": "\u0dc3\u0d82\u0dc0\u0dcf\u0daf \u0dc3\u0d82\u0d9a\u0dda\u0dad \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dba: {0} \u0dc3\u0d82\u0d9a\u0dda\u0dad\u0dcf {1}. \u0d86\u0daf\u0dcf\u0db1 {2}, \u0db4\u0dca\u0dbb\u0dad\u0dd2\u0daf\u0dcf\u0db1 {3}. \u0dc0\u0dd2\u0dc3\u0dca\u0dad\u0dbb \u0db6\u0dbd\u0db1\u0dca\u0db1",
