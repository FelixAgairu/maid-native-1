  "Discourages frequent repeats.": "\u0e9b\u0ec9\u0ead\u0e87\u0e81\u0eb1\u0e99\u0e81\u0eb2\u0e99\u0e8a\u0ec9\u0ecd\u0eb2\u0e8a\u0ec9\u0ecd\u0eb2\u0e8a\u0ecd\u0ec9\u0eb2\u0e8a\u0ec9\u0ecd\u0eb2",
  "Don't ask again": "\u0ea2\u0ec8\u0eb2\u0e96\u0eb2\u0ea1\u0ead\u0eb5\u0e81\u0ec0\u0e97\u0eb7\u0ec8\u0ead\u0eab\u0e99\u0eb6\u0ec8\u0e87",
  "Edit MCP server": "\u0ec1\u0e81\u0ec9\u0ec4\u0e82\u0ec0\u0e84\u0eb7\u0ec8\u0ead\u0e87\u0ec1\u0ea1\u0ec8\u0e82\u0ec8\u0eb2\u0e8d MCP",
  "Edit file": "\u0ec1\u0e81\u0ec9\u0ec4\u0e82\u0ec0\u0ead\u0e81\u0eb0\u0eaa\u0eb2\u0e99",
  "Edit message": "\u0ec1\u0e81\u0ec9\u0ec4\u0e82\u0e82\u0ecd\u0ec9\u0e84\u0ea7\u0eb2\u0ea1",
  "Edit system prompt": "\u0e81\u0eb2\u0e99\u0ec1\u0e81\u0ec9\u0ec4\u0e82\u0ea5\u0eb0\u0e9a\u0ebb\u0e9a prompt",
  "Endpoint": "\u0e88\u0eb8\u0e94\u0eaa\u0eb8\u0e94\u0e97\u0ec9\u0eb2\u0e8d",
  "Endpoint found": "\u0e88\u0eb8\u0e94\u0eaa\u0eb8\u0e94\u0e97\u0ec9\u0eb2\u0e8d\u0e97\u0eb5\u0ec8\u0e9e\u0ebb\u0e9a\u0ec0\u0eab\u0eb1\u0e99",
  "Enter a port between 1 and 65535": "\u0ec3\u0eaa\u0ec8 port \u0ea5\u0eb0 \u0eab\u0ea7\u0ec8\u0eb2\u0e87 1 \u0ec1\u0ea5\u0eb0 65535",
  "Enter an http or https URL": "\u0ec3\u0eaa\u0ec8 URL http \u0eab\u0ebc\u0eb7 https",
