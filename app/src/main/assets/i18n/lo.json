  "Export media": "\u0eaa\u0eb7\u0ec8\u0e81\u0eb2\u0e99\u0eaa\u0ebb\u0ec8\u0e87\u0ead\u0ead\u0e81",
  "Fades out while you type. Images are cropped to the pill and copied into the app.": "\u0eae\u0eb9\u0e9a\u0e9e\u0eb2\u0e9a\u0e96\u0eb7\u0e81\u0e95\u0eb1\u0e94\u0ec3\u0eaa\u0ec8\u0ec0\u0ea1\u0eb1\u0e94\u0ec1\u0ea5\u0eb0 \u0eaa\u0ecd\u0eb2 \u0ec0\u0e99\u0ebb\u0eb2\u0ec0\u0e82\u0ebb\u0ec9\u0eb2\u0ec3\u0e99\u0ec1\u0ead\u0eb1\u0e9a\u0e9e\u0ea5\u0eb4\u0ec0\u0e84\u0e8a\u0eb1\u0e99",
  "Fetch URL": "\u0ec0\u0ead\u0ebb\u0eb2 URL",
  "Files": "\u0ec4\u0e9f\u0ea5\u0ecc",
  "Find text in a file linked to the chat.": "\u0e8a\u0ead\u0e81\u0eab\u0eb2\u0e82\u0ecd\u0ec9\u0e84\u0ea7\u0eb2\u0ea1\u0ec3\u0e99\u0ec0\u0ead\u0e81\u0eb0\u0eaa\u0eb2\u0e99\u0e97\u0eb5\u0ec8\u0ec0\u0e8a\u0eb7\u0ec8\u0ead\u0ea1\u0ec2\u0e8d\u0e87\u0e81\u0eb1\u0e9a\u0e81\u0eb2\u0e99\u0eaa\u0ebb\u0e99\u0e97\u0eb0\u0e99\u0eb2.",
  "Frequency penalty": "\u0e81\u0eb2\u0e99\u0ea5\u0ebb\u0e87\u0ec2\u0e97\u0e94\u0e84\u0ea7\u0eb2\u0ea1\u0e96\u0eb5\u0ec8",
  "Hide reasoning": "\u0e9b\u0eb4\u0e94\u0e84\u0ea7\u0eb2\u0ea1\u0e84\u0eb4\u0e94\u0ec4\u0ea5\u0ec8",
  "Hide tool calls": "\u0ec0\u0e8a\u0eb7\u0ec8\u0ead\u0e87\u0e81\u0eb2\u0e99\u0ec2\u0e97\u0eab\u0eb2\u0ec0\u0e84\u0eb7\u0ec8\u0ead\u0e87\u0ea1\u0eb7",
  "Hide tool result": "\u0e9c\u0ebb\u0e99\u0e82\u0ead\u0e87\u0ec0\u0e84\u0eb7\u0ec8\u0ead\u0e87\u0ea1\u0eb7\u0ec0\u0e8a\u0eb7\u0ec8\u0ead\u0e87",
  "Higher is more random.": "\u0eaa\u0eb9\u0e87\u0e81\u0ea7\u0ec8\u0eb2\u0ec1\u0ea1\u0ec8\u0e99\u0eaa\u0eb0\u0e9a\u0eb2\u0e8d\u0e81\u0ea7\u0ec8\u0eb2.",
  "Image": "\u0eae\u0eb9\u0e9a\u0e9e\u0eb2\u0e9a",
  "Import": "\u0e81\u0eb2\u0e99\u0e99\u0ecd\u0eb2\u0ec0\u0e82\u0ebb\u0ec9\u0eb2",
  "In use": "\u0e81\u0eb2\u0e99\u0e99\u0ecd\u0eb2\u0ec3\u0e8a\u0ec9",
  "In {0} \u00b7 Out {1}": "\u0ec3\u0e99 {0} \u00b7 \u0ead\u0ead\u0e81 {1}",
  "In {0} \u00b7 Out {1} \u00b7 {2} {3} tokens": "\u0ec3\u0e99 {0} \u00b7 Out {1} \u00b7 {2} {3} tokens",
  "Includes attached images and audio in exported conversations.": "\u0ea5\u0ea7\u0ea1\u0e97\u0eb1\u0e87\u0eae\u0eb9\u0e9a\u0e9e\u0eb2\u0e9a\u0ec1\u0ea5\u0eb0\u0eaa\u0ebd\u0e87\u0e97\u0eb5\u0ec8\u0e95\u0eb4\u0e94\u0e95\u0ecd\u0ec8\u0ec3\u0e99\u0e81\u0eb2\u0e99\u0eaa\u0ebb\u0e99\u0e97\u0eb0\u0e99\u0eb2\u0e97\u0eb5\u0ec8\u0eaa\u0ebb\u0ec8\u0e87\u0ead\u0ead\u0e81.",
  "Input includes history sent again on each request. This is usage, not the number of tokens currently in the model's context window.": "\u0e81\u0eb2\u0e99\u0ec0\u0e82\u0ebb\u0ec9\u0eb2\u0e9b\u0eb0\u0e81\u0ead\u0e9a\u0ea1\u0eb5\u0e9b\u0eb0\u0eab\u0ea7\u0eb1\u0e94\u0e81\u0eb2\u0e99\u0eaa\u0ebb\u0ec8\u0e87\u0e84\u0eb7\u0e99\u0ec3\u0e99\u0ec1\u0e95\u0ec8\u0ea5\u0eb0 \u0e84\u0ecd\u0eb2 \u0eae\u0ec9\u0ead\u0e87\u0e82\u0ecd. \u0e99\u0eb5\u0ec9\u0ec1\u0ea1\u0ec8\u0e99\u0e81\u0eb2\u0e99 \u0e99\u0ecd\u0eb2 \u0ec3\u0e8a\u0ec9, \u0e9a\u0ecd\u0ec8\u0ec1\u0ea1\u0ec8\u0e99 \u0e88\u0ecd\u0eb2 \u0e99\u0ea7\u0e99 token \u0ec3\u0e99\u0e9b\u0eb0\u0e88\u0eb8\u0e9a\u0eb1\u0e99\u0ec3\u0e99\u0e9b\u0ec8\u0ead\u0e87\u0ea2\u0ec9\u0ebd\u0ea1\u0eaa\u0eb0\u0e9e\u0eb2\u0e9a\u0e82\u0ead\u0e87\u0eae\u0eb9\u0e9a\u0ec1\u0e9a\u0e9a.",
