  "No models loaded. Tap the scan button or refresh to fetch /models.": "\u0548\u0579 \u0574\u056b \u0574\u0578\u0564\u0565\u056c \u0579\u056b \u0562\u0565\u057c\u0576\u057e\u0565\u056c, \u057d\u0565\u0572\u0574\u0565\u0584 \u057d\u057f\u0578\u0582\u0563\u0574\u0561\u0576 \u056f\u0578\u0573\u0561\u056f\u0568 \u056f\u0561\u0574 \u0569\u0561\u0580\u0574\u0561\u0581\u0580\u0565\u0584 \u0574\u0578\u0564\u0565\u056c\u0576\u0565\u0580 \u057d\u057f\u0561\u0576\u0561\u056c\u0578\u0582 \u0570\u0561\u0574\u0561\u0580:",
  "None": "\u0548\u0579 \u0574\u0565\u056f\u0568",
  "Nothing saved yet. A preset keeps a Base URL and its API key together, so switching endpoints takes one tap.": "\u0544\u056b\u0576\u0579\u0565\u0582 \u0570\u056b\u0574\u0561 \u0578\u0579 \u0574\u056b \u0562\u0561\u0576 \u0579\u056b \u057a\u0561\u0570\u057a\u0561\u0576\u057e\u0565\u056c: \u0546\u0561\u056d\u0561\u0564\u0580\u0575\u0561\u056c\u0568 \u057a\u0561\u0570\u0578\u0582\u0574 \u0567 \u0570\u056b\u0574\u0576\u0561\u056f\u0561\u0576 URL- \u0568 \u0565\u0582 API- \u056b \u0562\u0561\u0576\u0561\u056c\u056b\u0576 \u0574\u056b\u0561\u057d\u056b\u0576, \u0561\u0575\u0576\u057a\u0565\u057d \u0578\u0580 \u057e\u0565\u0580\u057b\u0561\u0575\u056b\u0576 \u056f\u0565\u057f\u0565\u0580\u056b \u0583\u0578\u056d\u0561\u0576\u0561\u056f\u0578\u0582\u0574\u0568 \u057a\u0561\u0570\u0561\u0576\u057b\u0578\u0582\u0574 \u0567 \u0574\u0565\u056f \u057d\u0565\u0572\u0574\u0578\u0582\u0574:",
  "Nudges toward new topics.": "\u0546\u0578\u0580 \u0569\u0565\u0574\u0561\u0576\u0565\u0580\u056b \u057e\u0580\u0561 \u0576\u056b\u0570\u0561\u0580\u0578\u0582\u0574 \u0567:",
  "Off": "\u0540\u0565\u057c\u0561\u0581\u0580\u0565\u0584",
  "Off: system certificates only. On: system and user-installed CA certificates for API and MCP connections. Hostname and certificate checks remain enabled. Restart the app after installing or removing a CA.": "\u0553\u0561\u056f: \u0574\u056b\u0561\u0575\u0576 \u0570\u0561\u0574\u0561\u056f\u0561\u0580\u0563\u0561\u0575\u056b\u0576 \u057e\u056f\u0561\u0575\u0561\u056f\u0561\u0576\u0576\u0565\u0580: \u053f\u0561\u057c\u0578\u0582\u0581\u057e\u0561\u056e: \u0570\u0561\u0574\u0561\u056f\u0561\u0580\u0563\u0561\u0575\u056b\u0576 \u0565\u0582 \u0585\u0563\u057f\u0561\u0563\u0578\u0580\u056e\u0578\u0572\u056b \u056f\u0578\u0572\u0574\u056b\u0581 \u057f\u0565\u0572\u0561\u0564\u0580\u057e\u0561\u056e CA \u057e\u056f\u0561\u0575\u0561\u056f\u0561\u0576\u0576\u0565\u0580 API \u0565\u0582 MCP \u056f\u0561\u057a\u0565\u0580\u056b \u0570\u0561\u0574\u0561\u0580: \u0540\u0575\u0578\u0582\u0580\u0568\u0576\u056f\u0561\u056c\u0578\u0572\u056b \u0561\u0576\u0578\u0582\u0576 \u0565\u0582 \u057e\u056f\u0561\u0575\u0561\u056f\u0561\u0576\u0576\u0565\u0580\u056b \u057d\u057f\u0578\u0582\u0563\u0578\u0582\u0574\u0576\u0565\u0580\u0568 \u0574\u0576\u0578\u0582\u0574 \u0565\u0576 \u0561\u056f\u057f\u056b\u057e: \u054e\u0565\u0580\u0561\u0563\u0578\u0580\u056e\u0561\u0580\u056f\u0565\u056c \u0570\u0561\u057e\u0565\u056c\u057e\u0561\u056e\u0568 CA \u057f\u0565\u0572\u0561\u0564\u0580\u0565\u056c\u0578\u0582\u0581 \u056f\u0561\u0574 \u0570\u0565\u057c\u0561\u0581\u0576\u0565\u056c\u0578\u0582\u0581 \u0570\u0565\u057f\u0578:",
