  "New file": "\u041d\u043e\u0432 \u0444\u0430\u0458\u043b",
  "Next branch": "\u0421\u043b\u0435\u0434\u043d\u0430 \u0433\u0440\u0430\u043d\u043a\u0430",
  "No API key": "\u041d\u0435\u043c\u0430 \u043a\u043b\u0443\u0447 \u0437\u0430 API",
  "No chats yet": "\u0421\u0435 \u0443\u0448\u0442\u0435 \u043d\u0435\u043c\u0430 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440.",
  "No matching models": "\u041d\u0435\u043c\u0430 \u0441\u043e\u043e\u0434\u0432\u0435\u0442\u043d\u0438 \u043c\u043e\u0434\u0435\u043b\u0438",
  "No models loaded. Tap the scan button or refresh to fetch /models.": "\u041d\u0435 \u0441\u043c\u0435\u0430\u0442 \u0434\u0430 \u0431\u0438\u0434\u0430\u0442 \u0437\u0430\u0433\u0440\u0443\u0431\u0435\u043d\u0438 \u043c\u043e\u0434\u0435\u043b\u0438.",
  "None": "\u041d\u0438\u0442\u0443 \u0435\u0434\u0435\u043d.",
  "Nothing saved yet. A preset keeps a Base URL and its API key together, so switching endpoints takes one tap.": "\u0414\u043e\u0441\u0435\u0433\u0430 \u043d\u0435 \u0435 \u0437\u0430\u0447\u0443\u0432\u0430\u043d\u043e \u043d\u0438\u0448\u0442\u043e. \u041f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0435\u043d\u0430 \u043f\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0433\u043e \u0447\u0443\u0432\u0430 \u0411\u0430\u0437\u0435\u043d URL \u0438 \u043d\u0435\u0433\u043e\u0432\u0438\u043e\u0442 API \u043a\u043b\u0443\u0447 \u0437\u0430\u0435\u0434\u043d\u043e, \u0442\u0430\u043a\u0430 \u0448\u0442\u043e \u043f\u0440\u0435\u0444\u0440\u043b\u0430\u045a\u0435\u0442\u043e \u043d\u0430 \u043a\u0440\u0430\u0458\u043d\u0438\u0442\u0435 \u0442\u043e\u0447\u043a\u0438 \u0442\u0440\u0430\u0435 \u0435\u0434\u0435\u043d \u043f\u0440\u0438\u0442\u0438\u0441\u043e\u043a.",
  "Nudges toward new topics.": "\u0421\u0435 \u0434\u0432\u0438\u0436\u0438 \u043a\u043e\u043d \u043d\u043e\u0432\u0438 \u0442\u0435\u043c\u0438.",
  "Off": "\u0418\u0437\u043b\u0435\u0433\u0443\u0432\u0430\u043c.",
  "Off: system certificates only. On: system and user-installed CA certificates for API and MCP connections. Hostname and certificate checks remain enabled. Restart the app after installing or removing a CA.": "\u041e\u0431\u0435\u0437\u0432\u0440\u0435\u0434\u0435\u043d\u0438: \u0441\u0430\u043c\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0441\u043a\u0438 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u0438. \u041d\u0430: \u0441\u0438\u0441\u0442\u0435\u043c\u0441\u043a\u0438 \u0438 \u043a\u043e\u0440\u0438\u0441\u043d\u0438\u0447\u043a\u0438 \u0438\u043d\u0441\u0442\u0430\u043b\u0438\u0440\u0430\u043d\u0438 CA \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u0438 \u0437\u0430 API \u0438 MCP \u043f\u043e\u0432\u0440\u0437\u0430\u043d\u043e\u0441\u0442\u0438. \u0425\u043e\u0441\u0442 \u0438\u043c\u0435 \u0438 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0442 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u043e\u0441\u0442\u0430\u043d\u0443\u0432\u0430\u0430\u0442 \u0432\u043a\u043b\u0443\u0447\u0435\u043d\u0438. \u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u0441\u0442\u0430\u0440\u0442\u0438\u0440\u0430\u0458\u0442\u0435 \u0458\u0430 \u0430\u043f\u043b\u0438\u043a\u0430\u0446\u0438\u0458\u0430\u0442\u0430 \u043f\u043e \u0438\u043d\u0441\u0442\u0430\u043b\u0438\u0440\u0430\u045a\u0435 \u0438\u043b\u0438 \u043e\u0442\u0441\u0442\u0440\u0430\u043d\u0443\u0432\u0430\u045a\u0435 \u043d\u0430 CA.",
  "Older tool replies may only include the final request's usage.": "\u0421\u0442\u0430\u0440\u0438\u0442\u0435 \u043e\u0434\u0433\u043e\u0432\u043e\u0440\u0438 \u043d\u0430 \u0430\u043b\u0430\u0442\u043a\u0430\u0442\u0430 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0432\u043a\u043b\u0443\u0447\u0443\u0432\u0430\u0430\u0442 \u0441\u0430\u043c\u043e \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430 \u043d\u0430 \u043a\u043e\u043d\u0435\u0447\u043d\u043e\u0442\u043e \u0431\u0430\u0440\u0430\u045a\u0435.",
  "Output tokens": "\u0417\u043d\u0430\u0447\u043a\u0438 \u0437\u0430 \u0438\u0437\u043b\u0435\u0437",
  "Partial: totals include only known counts. Some requests are unfinished or have missing usage.": "\u041f\u0430\u0440\u0446\u0438\u0458\u0430\u043b\u043d\u0438: \u0432\u043a\u0443\u043f\u043d\u043e\u0441\u0442\u0438\u0442\u0435 \u0432\u043a\u043b\u0443\u0447\u0443\u0432\u0430\u0430\u0442 \u0441\u0430\u043c\u043e \u043f\u043e\u0437\u043d\u0430\u0442\u0438 \u0431\u0440\u043e\u0435\u0432\u0438.\u041d\u0435\u043a\u043e\u0438 \u0431\u0430\u0440\u0430\u045a\u0430 \u0441\u0435 \u043d\u0435\u0437\u0430\u0432\u0440\u0448\u0435\u043d\u0438 \u0438\u043b\u0438 \u043d\u0435\u043c\u0430\u0430\u0442 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430.",
