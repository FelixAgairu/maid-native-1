  "Linked files": "\u0421\u0432\u0440\u0437\u0430\u043d\u0438 \u0434\u0430\u0442\u043e\u0442\u0435\u043a\u0438",
  "List": "\u0421\u043f\u0438\u0441\u043e\u043a",
  "Local": "\u041b\u043e\u043a\u0430\u043b\u043d\u043e",
  "Long messages and reasoning scroll inside their cards. Expand any card to read it in full.": "\u0414\u044a\u043b\u0433\u0438 \u043f\u043e\u0440\u0430\u043a\u0438 \u0438 \u0440\u0430\u0437\u043c\u0438\u0441\u043b\u0443\u0432\u0430\u045a\u0435 \u0441\u0435 \u043f\u0440\u043e\u043a\u0440\u0443\u0447\u0443\u0432\u0430\u0430\u0442 \u0432\u043e \u043d\u0438\u0432\u043d\u0438\u0442\u0435 \u043a\u0430\u0440\u0442\u0438\u0447\u043a\u0438.",
  "Media token costs are not included in the estimate.": "\u0426\u0435\u043d\u0430\u0442\u0430 \u043d\u0430 \u043c\u0435\u0434\u0438\u0443\u043c\u0441\u043a\u0438\u0442\u0435 \u0442\u043e\u043a\u0435\u043d\u0438 \u043d\u0435 \u0435 \u0432\u043a\u043b\u0443\u0447\u0435\u043d\u0430 \u0432\u043e \u043f\u0440\u043e\u0446\u0435\u043d\u043a\u0430\u0442\u0430.",
  "Message": "\u041f\u043e\u0441\u043b\u0430\u043d\u0438\u0435",
