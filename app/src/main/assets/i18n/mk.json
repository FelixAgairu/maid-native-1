  "Unlink {0}": "\u0420\u0430\u0437\u0432\u0440\u0437\u0443\u0432\u0430\u045a\u0435 {0}",
  "Updating as the server reports usage. Some servers only report it when a reply finishes.": "\u0410\u0436\u0443\u0440\u0438\u0440\u0430\u045a\u0435 \u043a\u0430\u043a\u043e \u0448\u0442\u043e \u0441\u0435\u0440\u0432\u0435\u0440\u043e\u0442 \u0458\u0430 \u043f\u0440\u0438\u0458\u0430\u0432\u0443\u0432\u0430 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430\u0442\u0430. \u041d\u0435\u043a\u043e\u0438 \u0441\u0435\u0440\u0432\u0435\u0440\u0438 \u0458\u0430 \u043f\u0440\u0438\u0458\u0430\u0432\u0443\u0432\u0430\u0430\u0442 \u0441\u0430\u043c\u043e \u043a\u043e\u0433\u0430 \u043e\u0434\u0433\u043e\u0432\u043e\u0440\u043e\u0442 \u0435 \u0437\u0430\u0432\u0440\u0448\u0435\u043d.",
  "Usage sums API requests, including tool continuations and repeated input history. Missing or interrupted records remain partial. Deleted replies are excluded; this is not a billing ledger.": "\u0418\u0437\u043f\u043e\u043b\u0437\u043e\u0442 \u0441\u0443\u043c\u043c\u0438\u0440\u0430\u043d\u0438 API \u0431\u0430\u0440\u0430\u045a\u0430, \u0432\u043a\u043b\u0443\u0447\u0443\u0432\u0430\u0458\u045c\u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0443\u0432\u0430\u045a\u0435 \u043d\u0430 \u0430\u043b\u0430\u0442\u043a\u0430 \u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u0443\u0432\u0430\u045a\u0435 \u043d\u0430 \u0432\u043d\u0435\u0441\u0443\u0432\u0430\u045a\u0435 \u0438\u0441\u0442\u043e\u0440\u0438\u0458\u0430. \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0441\u0443\u0432\u0430 \u0438\u043b\u0438 \u043f\u0440\u0435\u043a\u0438\u043d\u0430\u0442 \u0437\u0430\u043f\u0438\u0441\u0438 \u043e\u0441\u0442\u0430\u043d\u0443\u0432\u0430\u0430\u0442 \u0434\u0435\u043b\u0443\u043c\u043d\u0438. \u0418\u0437\u0431\u0440\u0438\u0448\u0430\u043d\u0438 \u043e\u0434\u0433\u043e\u0432\u043e\u0440\u0438 \u0441\u0435 \u0438\u0441\u043a\u043b\u0443\u0447\u0435\u043d\u0438; \u043e\u0432\u0430 \u043d\u0435 \u0435 \u0441\u043c\u0435\u0442\u043a\u0430 \u043a\u043d\u0438\u0433\u0430.",
  "Use scroll view": "\u041a\u043e\u0440\u0438\u0441\u0442\u0435\u0442\u0435 \u0438\u0437\u0433\u043b\u0435\u0434 \u043d\u0430 \u043f\u0440\u0435\u043b\u0438\u0441\u0442\u0435\u045a\u0435\u0442\u043e",
  "User": "\u041a\u043e\u0440\u0438\u0441\u043d\u0438\u043a",
  "Uses the first message locally; keeps manually chosen titles and uses no extra tokens.": "\u041a\u043e\u0440\u0438\u0441\u0442\u0435 \u0458\u0430 \u043f\u0440\u0432\u0430\u0442\u0430 \u043f\u043e\u0440\u0430\u043a\u0430 \u043b\u043e\u043a\u0430\u043b\u043d\u043e; \u0447\u0443\u0432\u0430 \u0440\u044a\u0447\u043d\u043e \u0438\u0437\u0431\u0440\u0430\u043d\u0438 \u043d\u0430\u0441\u043b\u043e\u0432\u0438 \u0438 \u043d\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u043d\u0438 \u0437\u043d\u0430\u0446\u0438.",
  "Write access": "\u041d\u0430\u043f\u0438\u0448\u0435\u0442\u0435 \u043f\u0440\u0438\u0441\u0442\u0430\u043f",
