  "Read file": "\u041f\u0440\u043e\u0447\u0438\u0442\u0430\u045a\u0435 \u043d\u0430 \u0444\u0430\u0458\u043b\u043e\u0442",
  "Reads a web page.": "\u041f\u0440\u043e\u0447\u0438\u0442\u0430 \u0432\u0435\u0431 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430.",
