  "In {0} \u00b7 Out {1}": "\u0412\u043e {0} \u00b7 \u043d\u0430\u0434\u0432\u043e\u0440 {1}",
  "In {0} \u00b7 Out {1} \u00b7 {2} {3} tokens": "\u0412\u043e {0} \u00b7 \u0418\u0437\u043b\u0435\u0437\u0435 {1} \u00b7 {2} {3} \u0437\u043d\u0430\u0446\u0438",
  "Includes attached images and audio in exported conversations.": "\u0412\u043a\u043b\u0443\u0447\u0443\u0432\u0430 \u043f\u0440\u0438\u043a\u0430\u0447\u0435\u043d\u0438 \u0441\u043b\u0438\u043a\u0438 \u0438 \u0430\u0443\u0434\u0438\u043e \u0432\u043e \u0438\u0437\u0432\u043e\u0437\u0435\u043d\u0438\u0442\u0435 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0438.",
  "Input includes history sent again on each request. This is usage, not the number of tokens currently in the model's context window.": "\u0412\u043d\u0435\u0441\u0443\u0432\u0430\u045a\u0435\u0442\u043e \u0432\u043a\u043b\u0443\u0447\u0443\u0432\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u0458\u0430 \u0438\u0441\u043f\u0440\u0430\u0442\u0435\u043d\u0430 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u043d\u0430 \u0441\u0435\u043a\u043e\u0458\u0430 \u0431\u0430\u0440\u0430\u045a\u0435. \u041e\u0432\u0430 \u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430, \u0430 \u043d\u0435 \u0431\u0440\u043e\u0458\u043e\u0442 \u043d\u0430 \u0442\u043e\u043a\u0435\u043d\u0438 \u0432\u043e \u0442\u0435\u043a\u0441\u0442\u043e\u0442 \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446 \u043d\u0430 \u043c\u043e\u0434\u0435\u043b\u043e\u0442.",
  "Input tokens": "\u0412\u043d\u0435\u0441\u0443\u0432\u0430\u045a\u0435 \u0442\u043e\u043a\u0435\u043d\u0438",
  "Input \u00b7 {0}\nOutput \u00b7 {1}": "\u0412\u043b\u0435\u0437 \u00b7 {0} \u0418\u0437\u043b\u0435\u0437 \u00b7 {1}",
  "JavaScript": "\u0408\u0430\u0432\u0430\u0441\u043a\u0440\u0438\u043f\u0442",
  "Key can't be decrypted \u2014 re-save": "\u041a\u043b\u0443\u0447\u043e\u0442 \u043d\u0435 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0441\u0435 \u0434\u0435\u0448\u0438\u0444\u0440\u0438\u0440\u0430",
