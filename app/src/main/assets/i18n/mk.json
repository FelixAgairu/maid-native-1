  "More chat actions": "\u041f\u043e\u0432\u0435\u045c\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0432\u043e \u0447\u0430\u0442",
  "Must be a JSON object": "\u041c\u043e\u0440\u0430 \u0434\u0430 \u0431\u0438\u0434\u0435 JSON \u043e\u0431\u0458\u0435\u043a\u0442",
