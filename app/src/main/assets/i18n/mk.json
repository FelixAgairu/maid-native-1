  "Fades out while you type. Images are cropped to the pill and copied into the app.": "\u0418\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f\u0442\u0435 \u0441\u0435 \u043f\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438 \u043d\u0430 \u0442\u0430\u0431\u043b\u0435\u0442\u0430\u0442\u0430 \u0438 \u043a\u043e\u043f\u0438\u0440\u0430\u043d\u0438 \u0432\u043e \u0430\u043f\u043b\u0438\u043a\u0430\u0446\u0438\u0458\u0430\u0442\u0430.",
  "Fetch URL": "\u0414\u043e\u043d\u0435\u0441\u0435\u0442\u0435 URL",
  "Files": "\u0424\u0430\u0439\u043b\u043e\u0432\u0438",
  "Find text in a file linked to the chat.": "\u041d\u0430\u0458\u0434\u0435\u0442\u0435 \u0442\u0435\u043a\u0441\u0442 \u0432\u043e \u0434\u0430\u0442\u043e\u0442\u0435\u043a\u0430 \u043f\u043e\u0432\u0440\u0437\u0430\u043d\u0430 \u0441\u043e \u0447\u0430\u0442.",
  "Frequency penalty": "\u041d\u0430\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u0437\u0430 \u0447\u0435\u0441\u0442\u043e\u0442\u0430",
  "Hide reasoning": "\u0421\u043a\u0440\u0438\u0458\u0442\u0435 \u0440\u0430\u0437\u043c\u0438\u0441\u043b\u0443\u0432\u0430\u045a\u0435",
  "Hide tool calls": "\u0421\u043a\u0440\u0438\u0458\u0442\u0435 \u043f\u043e\u0432\u0438\u0446\u0438 \u043d\u0430 \u0430\u043b\u0430\u0442\u043a\u0430\u0442\u0430",
  "Hide tool result": "\u0420\u0435\u0437\u0443\u043b\u0442\u0430\u0442 \u043e\u0434 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0442 \u0437\u0430 \u043a\u0440\u0438\u0435\u045a\u0435",
  "Higher is more random.": "\u041f\u043e\u0432\u0438\u0441\u043e\u043a\u043e \u0435 \u043f\u043e\u0432\u0435\u045c\u0435 \u0441\u043b\u0443\u0447\u0430\u0458\u043d\u043e.",
  "Image": "\u0424\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0458\u0430",
