  "Expand all": "\u0420\u0430\u0437\u0448\u0438\u0440\u0435\u0442\u0435 \u0433\u0438 \u0441\u0438\u0442\u0435",
  "Export": "\u0418\u0437\u0432\u043e\u0437",
  "Export all": "\u0418\u0437\u0432\u043e\u0437 \u043d\u0430 \u0441\u0438\u0442\u0435",
