  "Fades out while you type. Images are cropped to the pill and copied into the app.": "\u0417\u0443\u0440\u0430\u0433 \u043d\u044c \u0442\u0430\u0431\u043b\u0435\u0442 \u0434\u044d\u044d\u0440 \u0431\u0443\u0443\u043b\u0433\u0430\u0436, \u0430\u043f\u043f\u043b\u0438\u043a\u0435\u0439\u0448\u043d\u0434 \u043d\u0443\u043d\u0442\u0430\u0433\u043b\u0430\u043d\u0430.",
  "Fetch URL": "URL-\u0438\u0439\u0433 \u0430\u0432\u0430\u0430\u0440\u0430\u0439",
  "Files": "\u0424\u0430\u0439\u043b\u0443\u0443\u0434",
