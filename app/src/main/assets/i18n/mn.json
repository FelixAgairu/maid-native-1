  "Next branch": "\u0414\u0430\u0440\u0430\u0430\u0433\u0438\u0439\u043d \u0441\u0430\u043b\u0431\u0430\u0440",
  "No API key": "API-\u0438\u0439\u043d \u0442\u043e\u0432\u0447 \u0431\u0430\u0439\u0445\u0433\u04af\u0439",
