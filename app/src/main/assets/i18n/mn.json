  "Expand all": "\u0411\u04af\u0445 \u0437\u04af\u0439\u043b\u0438\u0439\u0433 \u04e9\u0440\u0433\u04e9\u0436\u04af\u04af\u043b\u043d\u044d",
  "Export": "\u042d\u043a\u0441\u043f\u043e\u0440\u0442",
