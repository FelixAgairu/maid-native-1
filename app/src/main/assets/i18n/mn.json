  "Frequency penalty": "\u0428\u0430\u043b\u0433\u0430\u043b\u0442\u044b\u043d \u0438\u0445\u044d\u0432\u0447\u043b\u044d\u043d",
  "Hide reasoning": "\u0423\u0440\u044c\u0434\u0447\u0438\u043b\u0433\u0430\u0430\u0433 \u043d\u0443\u0443\u0446\u043b\u0430\u0445",
  "Hide tool calls": "\u04ae\u0439\u043b\u0434\u0432\u044d\u0440\u0438\u0439\u043d \u0434\u0443\u0443\u0434\u043b\u0430\u0433\u0430\u0433 \u043d\u0443\u0443\u0445",
  "Hide tool result": "\u0411\u0430\u0440\u0438\u043b\u0433\u044b\u043d \u04af\u0440 \u0434\u04af\u043d\u0433 \u043d\u0443\u0443\u0445",
  "Higher is more random.": "\u04ae\u04af\u043d\u044d\u044d\u0441 \u0434\u044d\u044d\u0448 \u043d\u044c \u0435\u0440\u0434\u0438\u0439\u043d \u044e\u043c.",
