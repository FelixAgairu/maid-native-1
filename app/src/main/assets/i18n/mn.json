  "Enter a port between 1 and 65535": "1 \u0431\u043e\u043b\u043e\u043d 65535 \u0445\u043e\u043e\u0440\u043e\u043d\u0434\u044b\u043d \u0433\u0430\u043b\u0442 \u0442\u044d\u0440\u044d\u0433",
