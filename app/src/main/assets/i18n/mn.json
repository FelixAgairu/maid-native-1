  "Includes attached images and audio in exported conversations.": "\u042d\u043a\u0441\u043f\u043e\u0440\u0442\u044b\u043d \u044f\u0440\u0438\u043b\u0446\u043b\u0430\u0433\u0443\u0443\u0434\u0430\u0434 \u0445\u0430\u0432\u0441\u0440\u0430\u043b\u0442\u044b\u043d \u0437\u0443\u0440\u0430\u0433, \u0430\u0443\u0434\u0438\u043e \u0431\u0438\u0447\u043b\u044d\u0433 \u043e\u0440\u0434\u043e\u0433.",
  "Input includes history sent again on each request. This is usage, not the number of tokens currently in the model's context window.": "\u042d\u043d\u044d \u043d\u044c \u0442\u0443\u0445\u0430\u0439\u043d \u0445\u04af\u0441\u044d\u043b\u0442 \u0434\u044d\u044d\u0440 \u0434\u0430\u0445\u0438\u043d \u0438\u0440\u04af\u04af\u043b\u0441\u044d\u043d \u0442\u04af\u04af\u0445\u0438\u0439\u0433 \u0431\u0430\u0433\u0442\u0430\u0430\u0434\u0430\u0433. \u042d\u043d\u044d \u043d\u044c \u0430\u0448\u0438\u0433\u043b\u0430\u043b\u0442, \u04af\u043b\u0433\u044d\u0440\u0438\u0439\u043d \u0445\u04af\u0440\u044d\u044d\u043b\u044d\u043d\u0433\u0438\u0439\u043d \u0446\u043e\u043d\u0445 \u0434\u0430\u0445\u044c \u0442\u043e\u043a\u0435\u043d\u04af\u04af\u0434\u0438\u0439\u043d \u0442\u043e\u043e \u0431\u0438\u0448 \u044e\u043c.",
  "Input tokens": "\u0414\u043e\u0442\u043e\u043e\u0434 \u0442\u044d\u043c\u0434\u044d\u0433\u04af\u04af\u0434",
