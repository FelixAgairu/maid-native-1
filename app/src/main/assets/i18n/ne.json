  "Hide reasoning": "\u0932\u0941\u0915\u093e\u0909\u0928\u0947 \u0924\u0930\u094d\u0915",
  "Hide tool calls": "\u0909\u092a\u0915\u0930\u0923 \u0915\u0932\u0939\u0930\u0942 \u0932\u0941\u0915\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d",
