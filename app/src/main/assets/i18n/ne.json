  "Unlink {0}": "\u0905\u0928\u0932\u093f\u0902\u0915 {0}",
  "Updating as the server reports usage. Some servers only report it when a reply finishes.": "\u0905\u092a\u0921\u0947\u091f \u0917\u0930\u094d\u0926\u093e \u0938\u0930\u094d\u092d\u0930\u0932\u0947 \u092a\u094d\u0930\u092f\u094b\u0917 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0917\u0930\u094d\u0926\u091b\u0964 \u0915\u0947\u0939\u0940 \u0938\u0930\u094d\u092d\u0930\u0939\u0930\u0942\u0932\u0947 \u092f\u0938\u0932\u093e\u0908 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u092e\u093e\u092a\u094d\u0924 \u092d\u090f\u092a\u091b\u093f \u092e\u093e\u0924\u094d\u0930 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0917\u0930\u094d\u0926\u091b\u0964",
  "Usage sums API requests, including tool continuations and repeated input history. Missing or interrupted records remain partial. Deleted replies are excluded; this is not a billing ledger.": "\u092a\u094d\u0930\u092f\u094b\u0917\u0932\u0947 \u090f\u092a\u0940\u0906\u0908 \u0905\u0928\u0941\u0930\u094b\u0927\u0939\u0930\u0942\u0915\u094b \u092f\u094b\u0917 \u0917\u0930\u094d\u0926\u091b, \u0909\u092a\u0915\u0930\u0923\u0915\u094b \u0928\u093f\u0930\u0928\u094d\u0924\u0930\u0924\u093e \u0930 \u0926\u094b\u0939\u094b\u0930\u094d\u092f\u093e\u0907\u090f\u0915\u094b \u0907\u0928\u092a\u0941\u091f \u0908\u0924\u093f\u0939\u093e\u0938 \u0938\u0939\u093f\u0924\u0964 \u0939\u0930\u093e\u0907\u0930\u0939\u0947\u0915\u093e \u0935\u093e \u0935\u093f\u091a\u094d\u091b\u0947\u0926 \u0917\u0930\u093f\u090f\u0915\u093e \u0930\u0947\u0915\u0930\u094d\u0921\u0939\u0930\u0942 \u0906\u0902\u0936\u093f\u0915 \u0930\u0939\u0928\u094d\u091b\u0928\u094d\u0964 \u0939\u091f\u093e\u0907\u090f\u0915\u094b \u0909\u0924\u094d\u0924\u0930\u0939\u0930\u0942 \u092c\u0939\u093f\u0937\u094d\u0915\u0943\u0924 \u091b\u0928\u094d; \u092f\u094b \u092c\u093f\u0932\u093f\u0919 \u0932\u0947\u091c\u0930 \u0939\u094b\u0907\u0928\u0964",
  "Use scroll view": "\u0938\u094d\u0915\u094d\u0930\u094b\u0932 \u0926\u0943\u0936\u094d\u092f \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",
  "User": "\u092a\u094d\u0930\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e",
  "Uses the first message locally; keeps manually chosen titles and uses no extra tokens.": "\u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0930\u0942\u092a\u092e\u093e \u092a\u0939\u093f\u0932\u094b \u0938\u0928\u094d\u0926\u0947\u0936 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u0926\u091b; \u092e\u0948\u0928\u094d\u092f\u0941\u0905\u0932 \u0930\u0942\u092a\u092e\u093e \u091a\u092f\u0928 \u0917\u0930\u093f\u090f\u0915\u093e \u0936\u0940\u0930\u094d\u0937\u0915\u0939\u0930\u0942 \u0930\u093e\u0916\u094d\u0926\u091b \u0930 \u0915\u0941\u0928\u0948 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u091f\u094b\u0915\u0928 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u0926\u0948\u0928\u0964",
  "Write access": "\u092a\u0939\u0941\u0901\u091a \u0932\u0947\u0916\u094d\u0928\u0941\u0939\u094b\u0938\u094d",
  "Write file": "\u092b\u093e\u0907\u0932 \u0932\u0947\u0916\u094d\u0928\u0941\u0939\u094b\u0938\u094d",
  "Writes": "\u0932\u0947\u0916\u094d\u091b",
  "Your name": "\u0924\u092a\u093e\u0908\u0902\u0915\u094b \u0928\u093e\u092e",
  "Your profile picture": "\u0924\u092a\u093e\u0908\u0902\u0915\u094b \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u092b\u094b\u091f\u094b",
  "stopped": "\u0930\u094b\u0915\u093f\u092f\u094b",
  "{0} addresses probed": "{0} \u0920\u0947\u0917\u093e\u0928\u093e\u0939\u0930\u0942 \u091c\u093e\u0901\u091a \u0917\u0930\u093f\u092f\u094b",
  "\u2248 is an estimate of the current branch and draft. Tokenization, tool schemas and media can change the actual count.": "\u2248 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u0936\u093e\u0916\u093e \u0930 \u092e\u0938\u094d\u092f\u094c\u0926\u093e\u0915\u094b \u0905\u0928\u0941\u092e\u093e\u0928 \u0939\u094b\u0964 \u091f\u094b\u0915\u0928\u093e\u0907\u091c\u0947\u0938\u0928, \u0909\u092a\u0915\u0930\u0923 \u092f\u094b\u091c\u0928\u093e\u0939\u0930\u0942 \u0930 \u092e\u093f\u0921\u093f\u092f\u093e\u0932\u0947 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0917\u0923\u0928\u093e \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0917\u0930\u094d\u0928 \u0938\u0915\u094d\u0926\u091b\u0964",
  "Collapse message": "\u0938\u0928\u094d\u0926\u0947\u0936 \u0938\u093f\u0915\u094b\u0921\u094d\u0928\u0941\u0939\u094b\u0938\u094d",
  "Expand message": "\u0938\u0928\u094d\u0926\u0947\u0936 \u0935\u093f\u0938\u094d\u0924\u093e\u0930 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",
  "Start Chat Session": "\u091a\u0948\u091f \u0938\u0924\u094d\u0930 \u0938\u0941\u0930\u0941 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",
  "Endpoint Switch": "\u090f\u0928\u094d\u0921\u092a\u0c3e\u0c2f\u0c3f\u0928\u094d\u091f \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d",
  "Auto-collapse messages": "\u0938\u0928\u094d\u0926\u0947\u0936\u0939\u0930\u0942 \u0938\u094d\u0935\u0924\u0903 \u0938\u093f\u0915\u094b\u0921\u094d\u0928\u0941\u0939\u094b\u0938\u094d",
